.primary_db_config
*.config
.env
.env.*
!.env.example

# Backup files
*.bak
*.backup
*.tmp
*~

# Testing
.pytest_cache/
.tox/
.coverage
.coverage.*
htmlcov/
.hypothesis/
.cache/

# Jupyter Notebook
.ipynb_checkpoints
*.ipynb

