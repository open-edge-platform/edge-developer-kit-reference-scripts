{
    "name": "edge-ai-demo-studio",
    "version": "1.0.0",
    "main": "main.js",
    "author": {
        "name": "Intel",
        "email": "admin@intel.com"
    },
    "homepage": "https://github.com/open-edge-platform/edge-developer-kit-reference-scripts/tree/main",
    "scripts": {
        "start": "electron .",
        "build": "electron-builder",
        "build:dir": "electron-builder --dir",
        "build:linux": "electron-builder --linux",
        "build:win": "electron-builder --win"
    },
    "license": "ISC",
    "description": "Edge AI Demo Studio - Electron Builder Version",
    "devDependencies": {
        "@electron/fuses": "^2.0.0",
        "electron": ">=41.10.3",
        "electron-builder": "^26.2.0"
    },
    "dependencies": {
        "@vscode/sudo-prompt": "^9.3.2",
        "electron-squirrel-startup": "^1.0.1",
        "tree-kill": "^1.2.2"
    },
    "build": {
        "icon": "assets/logo.png",
        "appId": "com.intel.edge-ai-demo-studio",
        "productName": "EdgeAIDemoStudio",
        "asar": true,
        "directories": {
            "output": "../out",
            "buildResources": "."
        },
        "extraResources": [
            {
                "from": "../build/",
                "to": "./"
            }
        ],
        "afterPack": "./electron-fuses.js",
        "linux": {
            "target": [
                {
                    "target": "zip",
                    "arch": [
                        "x64"
                    ]
                },
                {
                    "target": "deb",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "category": "Development",
            "executableName": "edge-ai-demo-studio"
        },
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        },
        "nsis": {
            "oneClick": false,
            "perMachine": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": false,
            "include": "installer.nsh",
            "installerIcon": "assets/logo.ico",
            "uninstallerIcon": "assets/logo.ico"
        },
        "files": [
            "**/*",
            "!**/node_modules/**/*",
            "node_modules/**/*"
        ]
    },
    "overrides": {
        "glob": ">=11.0.3"
    }
}