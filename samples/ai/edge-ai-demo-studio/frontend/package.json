{
  "name": "demo-studio-new",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -c -- next dev",
    "build": "next build",
    "start": "dotenv -c -- next start -H 127.0.0.1",
    "lint": "eslint . && tsc --noEmit",
    "lint:fix": "eslint . --fix",
    "codegen": "node ./scripts/generate-registries.mjs && eslint . --fix",
    "db:reset": "node ./scripts/reset-db.mjs",
    "export-bundle": "node ../scripts/export-bundle.mjs",
    "test": "playwright test",
    "update": "npx -y npm-check-updates -u --target minor && npm install",
    "update:check": "npx -y npm-check-updates --target latest",
    "test:ui": "playwright test --ui --ui-port 8081",
    "knip": "NODE_OPTIONS='--require tsconfig-paths/register' knip",
    "test:services": "playwright test --project=embedding-service --project=vectordb-service --project=oep-services --project=services",
    "test:samples": "playwright test --project=samples"
  },
  "dependencies": {
    "@ai-sdk-tool/parser": "^5.1.6",
    "@ai-sdk/mcp": "^2.0.84",
    "@ai-sdk/openai-compatible": "^3.0.78",
    "@ai-sdk/react": "^4.0.157",
    "@libsql/client": "0.14.0",
    "@next/bundle-analyzer": "^16.4.3",
    "@payloadcms/db-sqlite": "^3.92.0",
    "@payloadcms/next": "^3.92.0",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-virtual": "^3.14.13",
    "ai": "^7.0.153",
    "archiver": "^8.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv-cli": "^11.0.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "jsonata": "^2.1.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.21.0",
    "next": "^16.4.3",
    "payload": "^3.92.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rotating-file-stream": "^3.2.10",
    "shiki": "^4.0.2",
    "sonner": "^2.0.7",
    "streamdown": "^2.7.1",
    "tailwind-merge": "^3.5.0",
    "tree-kill": "^1.2.2",
    "undici": "^7.30.1",
    "uuid": "^14.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/archiver": "^8.0.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19",
    "@types/react-dom": "^19.2.7",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.7",
    "knip": "^6.32.2",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "shadcn": "^4.13.1",
    "tailwindcss": "^4",
    "tsconfig-paths": "^4.2.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "dompurify": "^3.4.16",
    "katex": "^0.18.2",
    "postcss": "^8.5.10",
    "undici": "^7.30.1",
    "sharp": "0.35.5",
