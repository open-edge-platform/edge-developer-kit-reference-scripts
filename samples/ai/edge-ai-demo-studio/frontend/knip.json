{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "tags": [
    "-lintignore"
  ],
  "ignore": [
    "src/components/ui/**",
    "src/components/ai-elements/**",
    "src/payload/migrations/**"
  ],
  "ignoreDependencies": [
    "@streamdown/.+",
    "^prettier$",
    "^prettier-plugin-tailwindcss$",
    "^eslint-plugin-prettier$",
    "^libsql$",
    "^hast-util-to-jsx-runtime$"
  ]
}