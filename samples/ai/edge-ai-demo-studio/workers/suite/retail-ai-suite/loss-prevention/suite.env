# Git branch or tag from https://github.com/open-edge-platform/edge-ai-suites.git
# used to resolve the pinned sample submodule commit.
EDGE_AI_SUITES_REF=2026.0

# Upstream sample git repository.
# Override to use a mirror or a local fork.
SAMPLE_REPO_URL=https://github.com/intel-retail/loss-prevention.git

# Path of this sample's submodule inside edge-ai-suites (used by setup.sh to
# resolve the pinned commit via `git ls-tree`).
SAMPLE_SUBMODULE_PATH=retail-ai-suite/loss-prevention