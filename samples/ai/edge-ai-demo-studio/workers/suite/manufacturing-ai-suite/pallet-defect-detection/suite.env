# Git branch or tag from https://github.com/open-edge-platform/edge-ai-suites.git
# used when this Manufacturing AI Suite sample is cloned into src/.
EDGE_AI_SUITES_REF=2026.0

# Upstream path inside the edge-ai-suites repo. All apps under
# industrial-edge-insights-vision share the same compose template; the actual
# sample is selected via the SAMPLE_APP env var when start.sh generates .env.
EDGE_AI_SUITES_APP_PATH=manufacturing-ai-suite/industrial-edge-insights-vision

# Upstream sample-app folder name (must match a folder under src/apps/ and
# the .env_<SAMPLE_APP> template at the suite root).
SAMPLE_APP=pallet-defect-detection

# Pipeline name to launch via sample_start.sh once the stack is healthy.
PIPELINE_NAME=pallet_defect_detection
