# Exam Marking Agent Configuration
# Copy this file to .env and fill in your credentials
# .env should NOT be committed to git

# Email Configuration (Gmail SMTP)
SENDER_EMAIL=your-email@gmail.com
SMTP_PASSWORD=<your-gmail-app-password>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true

# Telegram Configuration
TELEGRAM_BOT_TOKEN=<your-telegram-bot-token>

# LLM Configuration (for email/message generation)
# Unset: the running Text Generation instance, looked up through the app.
# LLM_API_BASE=http://localhost:8001/v1
LLM_MODEL=dummy
LLM_API_KEY=<your-api-key>

# Paths
# Unset: results/ in this instance's data dir (data/exam-marking-agent/<instance>/).
# RESULTS_PATH=/path/to/results
# /path/to/Contact_Info.xlsx
DISPATCH_CONTACTS_FILE=./Contact_Info.xlsx