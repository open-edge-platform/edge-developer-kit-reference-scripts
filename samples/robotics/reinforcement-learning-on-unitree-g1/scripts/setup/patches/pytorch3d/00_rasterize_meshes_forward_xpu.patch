diff --git a/pytorch3d/csrc/rasterize_meshes/rasterize_meshes_xpu.sycl b/pytorch3d/csrc/rasterize_meshes/rasterize_meshes_xpu.sycl
new file mode 100644
index 0000000..e77f66e
--- /dev/null
+++ b/pytorch3d/csrc/rasterize_meshes/rasterize_meshes_xpu.sycl
@@ -0,0 +1,305 @@
+#include <ATen/ATen.h>
+#include <c10/xpu/XPUStream.h>
+#include <sycl/sycl.hpp>
+#include <torch/types.h>
+
+#include <cstdint>
+#include <tuple>
+
+namespace {
+
+constexpr int kMaxFacesPerPixel = 150;
+constexpr float kEpsilon = 1e-8f;
+
+struct Pixel {
+  float z;
+  int64_t face_idx;
+  float dist;
+  float bary0;
+  float bary1;
+  float bary2;
+};
+
+class RasterizeMeshesNaiveKernel;
+
+inline float EdgeFunction(
+    const float px,
+    const float py,
+    const float v0x,
+    const float v0y,
+    const float v1x,
+    const float v1y) {
+  return (px - v0x) * (v1y - v0y) - (py - v0y) * (v1x - v0x);
+}
+
+inline float PixelNdc(const int i, const int size1, const int size2) {
+  const float range = size1 > size2 ? 2.0f * size1 / size2 : 2.0f;
+  const float offset = range / 2.0f;
+  return -offset + (range * i + offset) / size1;
+}
+
+inline float PointLineDistanceSquared(
+    const float px,
+    const float py,
+    const float ax,
+    const float ay,
+    const float bx,
+    const float by) {
+  const float dx = bx - ax;
+  const float dy = by - ay;
+  const float length_squared = dx * dx + dy * dy;
+  if (length_squared <= kEpsilon) {
+    const float ex = px - bx;
+    const float ey = py - by;
+    return ex * ex + ey * ey;
+  }
+  float t = ((px - ax) * dx + (py - ay) * dy) / length_squared;
+  t = sycl::fmin(sycl::fmax(t, 0.0f), 1.0f);
+  const float ex = ax + t * dx - px;
+  const float ey = ay + t * dy - py;
+  return ex * ex + ey * ey;
+}
+
+inline float PointTriangleDistanceSquared(
+    const float px,
+    const float py,
+    const float v0x,
+    const float v0y,
+    const float v1x,
+    const float v1y,
+    const float v2x,
+    const float v2y) {
+  return sycl::fmin(
+      PointLineDistanceSquared(px, py, v0x, v0y, v1x, v1y),
+      sycl::fmin(
+          PointLineDistanceSquared(px, py, v0x, v0y, v2x, v2y),
+          PointLineDistanceSquared(px, py, v1x, v1y, v2x, v2y)));
+}
+
+inline bool PixelLess(const Pixel& lhs, const Pixel& rhs) {
+  return lhs.z < rhs.z || (lhs.z == rhs.z && lhs.face_idx < rhs.face_idx);
+}
+
+} // namespace
+
+std::tuple<at::Tensor, at::Tensor, at::Tensor, at::Tensor>
+RasterizeMeshesNaiveXpu(
+    const torch::Tensor& face_verts,
+    const torch::Tensor& mesh_to_face_first_idx,
+    const torch::Tensor& num_faces_per_mesh,
+    const torch::Tensor& clipped_faces_neighbor_idx,
+    const std::tuple<int, int> image_size,
+    const float blur_radius,
+    const int faces_per_pixel,
+    const bool perspective_correct,
+    const bool clip_barycentric_coords,
+    const bool cull_backfaces) {
+  TORCH_CHECK(
+      face_verts.dim() == 3 && face_verts.size(1) == 3 &&
+          face_verts.size(2) == 3,
+      "face_verts must have dimensions (num_faces, 3, 3)");
+  TORCH_CHECK(
+      face_verts.scalar_type() == at::kFloat,
+      "face_verts must have dtype float32 on XPU");
+  TORCH_CHECK(
+      faces_per_pixel >= 0 && faces_per_pixel <= kMaxFacesPerPixel,
+      "faces_per_pixel must be in [0, ",
+      kMaxFacesPerPixel,
+      "]");
+  TORCH_CHECK(
+      mesh_to_face_first_idx.device() == face_verts.device() &&
+          num_faces_per_mesh.device() == face_verts.device() &&
+          clipped_faces_neighbor_idx.device() == face_verts.device(),
+      "RasterizeMeshesNaiveXpu expects all inputs on the same XPU");
+
+  const int64_t batch_size = num_faces_per_mesh.size(0);
+  const int height = std::get<0>(image_size);
+  const int width = std::get<1>(image_size);
+  const int64_t num_faces = face_verts.size(0);
+  TORCH_CHECK(
+      mesh_to_face_first_idx.numel() == batch_size,
+      "num_faces_per_mesh and mesh_to_face_first_idx must have the same length");
+  TORCH_CHECK(
+      clipped_faces_neighbor_idx.numel() == num_faces,
+      "clipped_faces_neighbor_idx must have one entry per face");
+
+  auto face_idx_options = num_faces_per_mesh.options().dtype(at::kLong);
+  auto float_options = face_verts.options().dtype(at::kFloat);
+  at::Tensor face_idxs = at::full(
+      {batch_size, height, width, faces_per_pixel}, -1, face_idx_options);
+  at::Tensor zbuf = at::full(
+      {batch_size, height, width, faces_per_pixel}, -1, float_options);
+  at::Tensor pix_dists = at::full(
+      {batch_size, height, width, faces_per_pixel}, -1, float_options);
+  at::Tensor bary = at::full(
+      {batch_size, height, width, faces_per_pixel, 3}, -1, float_options);
+
+  const int64_t pixel_count = batch_size * height * width;
+  if (pixel_count == 0) {
+    return std::make_tuple(face_idxs, zbuf, bary, pix_dists);
+  }
+
+  auto face_verts_contiguous = face_verts.contiguous();
+  auto first_idx_contiguous = mesh_to_face_first_idx.contiguous();
+  auto faces_per_mesh_contiguous = num_faces_per_mesh.contiguous();
+  auto neighbor_idx_contiguous = clipped_faces_neighbor_idx.contiguous();
+  const float* face_verts_ptr = face_verts_contiguous.data_ptr<float>();
+  const int64_t* first_idx_ptr = first_idx_contiguous.data_ptr<int64_t>();
+  const int64_t* faces_per_mesh_ptr =
+      faces_per_mesh_contiguous.data_ptr<int64_t>();
+  const int64_t* neighbor_idx_ptr =
+      neighbor_idx_contiguous.data_ptr<int64_t>();
+  int64_t* face_idxs_ptr = face_idxs.data_ptr<int64_t>();
+  float* zbuf_ptr = zbuf.data_ptr<float>();
+  float* pix_dists_ptr = pix_dists.data_ptr<float>();
+  float* bary_ptr = bary.data_ptr<float>();
+
+  auto stream = c10::xpu::getCurrentXPUStream(face_verts.device().index());
+  stream.queue().parallel_for<RasterizeMeshesNaiveKernel>(
+      sycl::range<1>(pixel_count),
+      [=](sycl::id<1> item) {
+        const int64_t pixel = item[0];
+        const int n = pixel / (height * width);
+        const int pixel_in_image = pixel % (height * width);
+        const int yi = height - 1 - pixel_in_image / width;
+        const int xi = width - 1 - pixel_in_image % width;
+        const float px = PixelNdc(xi, width, height);
+        const float py = PixelNdc(yi, height, width);
+        const float bbox_radius = sycl::sqrt(blur_radius);
+
+        Pixel top_faces[kMaxFacesPerPixel];
+        int top_count = 0;
+        float max_z = -1000.0f;
+        int max_z_idx = -1;
+        const int64_t face_begin = first_idx_ptr[n];
+        const int64_t face_end = face_begin + faces_per_mesh_ptr[n];
+
+        for (int64_t f = face_begin; f < face_end; ++f) {
+          const int64_t offset = f * 9;
+          const float x0 = face_verts_ptr[offset + 0];
+          const float y0 = face_verts_ptr[offset + 1];
+          const float z0 = face_verts_ptr[offset + 2];
+          const float x1 = face_verts_ptr[offset + 3];
+          const float y1 = face_verts_ptr[offset + 4];
+          const float z1 = face_verts_ptr[offset + 5];
+          const float x2 = face_verts_ptr[offset + 6];
+          const float y2 = face_verts_ptr[offset + 7];
+          const float z2 = face_verts_ptr[offset + 8];
+
+          const float min_x = sycl::fmin(x0, sycl::fmin(x1, x2));
+          const float min_y = sycl::fmin(y0, sycl::fmin(y1, y2));
+          const float min_z = sycl::fmin(z0, sycl::fmin(z1, z2));
+          const float max_x = sycl::fmax(x0, sycl::fmax(x1, x2));
+          const float max_y = sycl::fmax(y0, sycl::fmax(y1, y2));
+          const float max_face_z = sycl::fmax(z0, sycl::fmax(z1, z2));
+          const bool outside_bbox =
+              px > max_x + bbox_radius || px < min_x - bbox_radius ||
+              py > max_y + bbox_radius || py < min_y - bbox_radius ||
+              min_z < kEpsilon;
+          const float face_area = EdgeFunction(x0, y0, x1, y1, x2, y2);
+          const bool back_face = face_area < 0.0f;
+          const bool zero_area =
+              face_area <= kEpsilon && face_area >= -kEpsilon;
+          if (max_face_z < 0.0f || (cull_backfaces && back_face) ||
+              outside_bbox || zero_area) {
+            continue;
+          }
+
+          const float area =
+              EdgeFunction(x2, y2, x0, y0, x1, y1) + kEpsilon;
+          float b0 = EdgeFunction(px, py, x1, y1, x2, y2) / area;
+          float b1 = EdgeFunction(px, py, x2, y2, x0, y0) / area;
+          float b2 = EdgeFunction(px, py, x0, y0, x1, y1) / area;
+          if (perspective_correct) {
+            const float w0_top = b0 * z1 * z2;
+            const float w1_top = z0 * b1 * z2;
+            const float w2_top = z0 * z1 * b2;
+            const float denom = sycl::fmax(w0_top + w1_top + w2_top, kEpsilon);
+            b0 = w0_top / denom;
+            b1 = w1_top / denom;
+            b2 = w2_top / denom;
+          }
+          const bool inside = b0 > 0.0f && b1 > 0.0f && b2 > 0.0f;
+          if (clip_barycentric_coords) {
+            b0 = sycl::fmax(b0, 0.0f);
+            b1 = sycl::fmax(b1, 0.0f);
+            b2 = sycl::fmax(b2, 0.0f);
+            const float bary_sum = sycl::fmax(b0 + b1 + b2, 1e-5f);
+            b0 /= bary_sum;
+            b1 /= bary_sum;
+            b2 /= bary_sum;
+          }
+          const float pz = b0 * z0 + b1 * z1 + b2 * z2;
+          if (pz < 0.0f) {
+            continue;
+          }
+
+          const float distance = PointTriangleDistanceSquared(
+              px, py, x0, y0, x1, y1, x2, y2);
+          const float signed_distance = inside ? -distance : distance;
+          if (!inside && distance >= blur_radius) {
+            continue;
+          }
+
+          const int64_t neighbor_idx = neighbor_idx_ptr[f];
+          int neighbor_top_idx = -1;
+          if (neighbor_idx != -1) {
+            for (int i = 0; i < top_count; ++i) {
+              if (top_faces[i].face_idx == neighbor_idx) {
+                neighbor_top_idx = i;
+                break;
+              }
+            }
+          }
+          if (neighbor_top_idx != -1) {
+            if (distance < sycl::fabs(top_faces[neighbor_top_idx].dist)) {
+              top_faces[neighbor_top_idx] =
+                  {pz, f, signed_distance, b0, b1, b2};
+              if (pz > max_z) {
+                max_z = pz;
+                max_z_idx = neighbor_top_idx;
+              }
+            }
+          } else if (top_count < faces_per_pixel) {
+            top_faces[top_count] = {pz, f, signed_distance, b0, b1, b2};
+            if (pz > max_z) {
+              max_z = pz;
+              max_z_idx = top_count;
+            }
+            ++top_count;
+          } else if (pz < max_z) {
+            top_faces[max_z_idx] = {pz, f, signed_distance, b0, b1, b2};
+            max_z = pz;
+            for (int i = 0; i < top_count; ++i) {
+              if (top_faces[i].z > max_z) {
+                max_z = top_faces[i].z;
+                max_z_idx = i;
+              }
+            }
+          }
+        }
+
+        for (int i = 0; i < top_count - 1; ++i) {
+          for (int j = 0; j < top_count - i - 1; ++j) {
+            if (PixelLess(top_faces[j + 1], top_faces[j])) {
+              const Pixel temp = top_faces[j];
+              top_faces[j] = top_faces[j + 1];
+              top_faces[j + 1] = temp;
+            }
+          }
+        }
+
+        const int64_t output_idx = pixel * faces_per_pixel;
+        for (int k = 0; k < top_count; ++k) {
+          const Pixel current = top_faces[k];
+          face_idxs_ptr[output_idx + k] = current.face_idx;
+          zbuf_ptr[output_idx + k] = current.z;
+          pix_dists_ptr[output_idx + k] = current.dist;
+          bary_ptr[(output_idx + k) * 3 + 0] = current.bary0;
+          bary_ptr[(output_idx + k) * 3 + 1] = current.bary1;
+          bary_ptr[(output_idx + k) * 3 + 2] = current.bary2;
+        }
+      });
+
+  return std::make_tuple(face_idxs, zbuf, bary, pix_dists);
+}
