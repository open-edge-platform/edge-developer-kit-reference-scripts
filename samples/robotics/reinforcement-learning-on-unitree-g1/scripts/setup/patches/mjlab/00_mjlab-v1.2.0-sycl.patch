+def configure_xpu_backends(allow_tf32: bool = True, deterministic: bool = False):
+  """Configure PyTorch XPU matmul precision and determinism."""
+  torch.set_float32_matmul_precision("high" if allow_tf32 else "highest")
+  if allow_tf32 and not torch.xpu.is_tf32_supported():
+    device_id = torch.xpu.current_device()
