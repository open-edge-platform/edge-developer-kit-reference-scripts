 def select_gpus(
   gpu_ids: list[int] | Literal["all"] | None,
@@ -72,3 +77,56 @@ def select_gpus(
   num_gpus = len(selected_gpus)
 
   return selected_gpus, num_gpus
+
+
+def warp_view_of_xpu(
+  tensor: torch.Tensor, *, dtype=None, shape=None, strides=None
+) -> wp.array:
+  if tensor.device.type != "xpu" or tensor.device.index != torch.xpu.current_device():
+    raise ValueError("expected a tensor on the current XPU device")
+  if not tensor.is_contiguous() or tensor.numel() == 0 or tensor.requires_grad:
+    raise ValueError("expected a nonempty, contiguous XPU tensor without gradients")
+
+  sycl = wp._src.context.runtime.sycl
+  if sycl.wp_sycl_pointer_type(tensor.data_ptr()) not in (2, 3):
+    raise RuntimeError("XPU pointer is not device-accessible from the Warp SYCL queue")
+
+  if dtype is None:
+    dtype = wp.dtype_from_torch(tensor.dtype)
+  if shape is None:
+    shape = tuple(tensor.shape)
+  scalar_dtype = getattr(dtype, "_wp_scalar_type_", dtype)
+  type_shape = getattr(dtype, "_shape_", ())
+  if wp.dtype_from_torch(tensor.dtype) != scalar_dtype or tuple(tensor.shape) != (*shape, *type_shape):
+    raise ValueError("XPU tensor shape or dtype does not match the Warp array")
+
+  array = wp.array(
+    ptr=tensor.data_ptr(),
+    shape=shape,
+    strides=strides,
+    dtype=dtype,
+    device="sycl",
+    copy=False,
+  )
+  array._ref = tensor
+  return array
+
+
+def promote_warp_array_to_xpu(array: wp.array) -> tuple[wp.array, torch.Tensor]:
+  if not array.device.is_sycl or not array.is_contiguous or array.size == 0:
+    raise ValueError("expected a nonempty, contiguous Warp SYCL array")
+  wp.synchronize_device(array.device)
+  tensor = wp.to_torch(array).to(device="xpu", copy=True)
+  torch.xpu.current_stream(tensor.device).synchronize()
+  return warp_view_of_xpu(
+    tensor, dtype=array.dtype, shape=array.shape, strides=array.strides
+  ), tensor
+
+
+def xpu_stream_for_warp(device: torch.device) -> torch.xpu.Stream:
+  if device.type != "xpu":
+    raise ValueError("expected an XPU device")
+  sycl = wp._src.context.runtime.sycl
+  return torch.xpu.get_stream_from_external(
+    sycl.wp_sycl_queue_ptr(), device=device
+  )
