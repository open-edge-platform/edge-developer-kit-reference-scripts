+def to_xpu(data):
+    """Move data in the batch to xpu(), carefully handle data that is not tensor"""
+    if isinstance(data, torch.Tensor):
+        return data.xpu()
+    elif isinstance(data, dict):
+        return {k: to_xpu(v) for k, v in data.items()}
+    elif isinstance(data, list):
+        return [to_xpu(v) for v in data]
+    else:
+        return data
 
