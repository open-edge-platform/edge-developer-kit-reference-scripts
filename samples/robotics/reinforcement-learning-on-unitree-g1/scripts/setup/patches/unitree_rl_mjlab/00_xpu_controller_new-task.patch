+from __future__ import annotations
+
+from contextlib import contextmanager
+from dataclasses import dataclass
+
+import torch
+
+from mjlab.envs import ManagerBasedRlEnv
+from mjlab.tasks.tracking.mdp import MotionCommand, MotionCommandCfg
+
+from .types import MotionCommandAction
+
+
+class ChainedMotionCommand(MotionCommand):
+  """Motion command that preserves robot state and supports composable actions."""
+
+  _reset_robot_state = False
+  _reset_mode = "default"
+
+  def __init__(self, cfg: MotionCommandCfg, env: ManagerBasedRlEnv) -> None:
+    super().__init__(cfg, env)
+    self._actions: list[MotionCommandAction] = []
+
+  def add_action(self, action: MotionCommandAction) -> None:
+    self._actions.append(action)
+
+  def reset_actions(self) -> None:
+    for action in reversed(self._actions):
+      action.reset(self)
+    self._actions.clear()
+
+  @property
+  def joint_pos(self) -> torch.Tensor:
+    values = self.motion.joint_pos[self.time_steps]
+    for action in self._actions:
+      values = action.transform_joint_pos(self, values)
+    return values
+
+  @property
+  def joint_vel(self) -> torch.Tensor:
+    values = self.motion.joint_vel[self.time_steps]
+    for action in self._actions:
+      values = action.transform_joint_vel(self, values)
+    return values
+
+  @property
+  def body_pos_w(self) -> torch.Tensor:
+    values = self.motion.body_pos_w[self.time_steps]
+    for action in self._actions:
+      values = action.transform_body_pos(self, values)
+    return values + self._env.scene.env_origins[:, None, :]
+
+  @property
+  def body_quat_w(self) -> torch.Tensor:
+    values = self.motion.body_quat_w[self.time_steps]
+    for action in self._actions:
+      values = action.transform_body_quat(self, values)
+    return values
+
+  @property
+  def body_lin_vel_w(self) -> torch.Tensor:
+    values = self.motion.body_lin_vel_w[self.time_steps]
+    for action in self._actions:
+      values = action.transform_body_lin_vel(self, values)
+    return values
+
+  @property
+  def body_ang_vel_w(self) -> torch.Tensor:
+    values = self.motion.body_ang_vel_w[self.time_steps]
+    for action in self._actions:
+      values = action.transform_body_ang_vel(self, values)
+    return values
+
+  @property
+  def anchor_pos_w(self) -> torch.Tensor:
+    return self.body_pos_w[:, self.motion_anchor_body_index]
+
+  @property
+  def anchor_quat_w(self) -> torch.Tensor:
+    return self.body_quat_w[:, self.motion_anchor_body_index]
+
+  @property
+  def anchor_lin_vel_w(self) -> torch.Tensor:
+    return self.body_lin_vel_w[:, self.motion_anchor_body_index]
+
+  @property
+  def anchor_ang_vel_w(self) -> torch.Tensor:
+    return self.body_ang_vel_w[:, self.motion_anchor_body_index]
+
+  def _resample_command(self, env_ids: torch.Tensor) -> None:
+    if self._reset_robot_state:
+      match self._reset_mode:
+        case "default":
+          super()._resample_command(env_ids)
+        case _:
+          raise ValueError(f"Unknown reset mode: {self._reset_mode}")
+      return
+    self.time_steps[env_ids] = torch.clamp(
+      self.time_steps[env_ids], max=self.motion.time_step_total - 1
+    )
+
+  @contextmanager
+  def full_reset_enabled(self):
+    previous = self._reset_robot_state
+    self._reset_robot_state = True
+    try:
+      yield
+    finally:
+      self._reset_robot_state = previous
+
+
+@dataclass(kw_only=True)
+class ChainedMotionCommandCfg(MotionCommandCfg):
+  def build(self, env: ManagerBasedRlEnv) -> MotionCommand:
+    return ChainedMotionCommand(self, env)
