+import time
+import traceback
+
+import torch
+
+from mjlab.viewer import NativeMujocoViewer, ViserPlayViewer
+from mjlab.viewer.base import VerbosityLevel
+
+from .policy_graph import GraphPolicy, TransitionContext
+
+
+class MultiPolicyViewerMixin:
+  policy: GraphPolicy
+
+  def _execute_step(self) -> bool:
+    try:
+      with torch.no_grad():
+        obs = self.env.get_observations()
+        actions = self.policy(obs)
+        motion_finished = self.policy.motion_is_on_final_frame()
+        step_result = self.env.step(actions)
+        self.policy.observe_transition_actions()
+        self._step_count += 1
+        self._stats_steps += 1
+        context = TransitionContext(
+          source=self.policy.active_node,
+          step_result=step_result,
+          motion_was_on_final_frame=motion_finished,
+          step_count=self._step_count,
+        )
+        edge = self.policy.find_transition(context)
+        if edge is not None:
+          self.policy.transition(edge)
+        return True
+    except Exception:
+      self._last_error = traceback.format_exc()
+      self.log(
+        f"[ERROR] Exception during step:\n{self._last_error}",
+        VerbosityLevel.SILENT,
+      )
+      self.pause()
+      return False
+
+  def reset_environment(self) -> None:
+    self.policy.reset_environment(self.env)
+    self._step_count = 0
+    self._sim_budget = 0.0
+    self._last_error = None
+    self._last_tick_time = time.perf_counter()
+
+
+class ViserMultiPlayViewer(MultiPolicyViewerMixin, ViserPlayViewer):
+  pass
+
+
+class NativeMultiPlayViewer(MultiPolicyViewerMixin, NativeMujocoViewer):
+  pass
