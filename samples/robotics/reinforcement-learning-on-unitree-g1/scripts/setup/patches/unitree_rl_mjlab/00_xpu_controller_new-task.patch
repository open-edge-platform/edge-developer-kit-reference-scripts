+from typing import TYPE_CHECKING, Any
+
+import torch
+
+if TYPE_CHECKING:
+    from mjlab.envs import ManagerBasedRlEnv
+    from mjlab.managers.curriculum_manager import CurriculumTermCfg
+    from mjlab.managers.reward_manager import RewardTermCfg
+
+def _resolve_env_ids(
+    env,
+    env_ids: torch.Tensor | slice,
+):
+    if isinstance(env_ids, slice):
+        env_ids = torch.arange(env.num_envs, device=env.device, dtype=torch.long)[env_ids]
+    return env_ids.to(env.device, dtype=torch.long)
+
+class penalty_curriculum:
+    """Linearly ramp penalty reward weights as the policy survives longer episodes.
+
+    Reference: mjlab's ``reward_curriculum``
+    
+    term_cfgs are resolved once and mutated in place, 
+    but the ramp is driven by an EMA of episode length
+    instead of fixed training-step stages.
+
+    TODO: verify scaling is correct (not tested yet)
+    """
+
+    def __init__(self, cfg: "CurriculumTermCfg", env: "ManagerBasedRlEnv"):
+        term_names: tuple[str, ...] = cfg.params["term_names"]
+        self._current_scale = 1.0
+        self._ema_eps_len = 0.0
+        self._min_scale = cfg.params.get("min_scale", 0.0)
+        self._degree = cfg.params.get("degree", 0.01)
+        self._level_down_threshold = cfg.params.get("level_down_threshold", 0.3)
+        self._level_up_threshold = cfg.params.get("level_up_threshold", 0.7)
+        self._term_cfgs: dict[str, "RewardTermCfg"] = {
+            name: env.reward_manager.get_term_cfg(name) for name in term_names
+        }
+        self._base_weights: dict[str, float] = {
+            name: term_cfg.weight for name, term_cfg in self._term_cfgs.items()
+        }
+
+    def __call__(
+        self,
+        env: "ManagerBasedRlEnv",
+        env_ids: torch.Tensor | slice,
+        term_names: tuple[str, ...],
+        min_scale: float,
+        degree: float,
+        level_down_threshold: float,
+        level_up_threshold: float,
+    ) -> dict[str, Any]:
+        del term_names, min_scale, degree, level_down_threshold, level_up_threshold
+
+        env_ids = _resolve_env_ids(env, env_ids)
+        if env_ids.numel() == 0:
+            return {
+                "value": 1.0, 
+            }
+
+        normalized_mean_length = env.episode_length_buf[env_ids].float().mean().item() / env.max_episode_length
+        
+        scale = self._scale(normalized_mean_length)
+        
+        for name, term_cfg in self._term_cfgs.items():
+            term_cfg.weight = self._base_weights[name] * scale
+
+        return {
+            "value": scale, 
+            "current_scale": self._current_scale,
+            "mean_normalized_episode_steps": normalized_mean_length,
+            "degree": self._degree,
+            "min_scale": self._min_scale,
+            "level_down_threshold": self._level_down_threshold,
+            "level_up_threshold": self._level_up_threshold,
+        }
+
+    def _scale(self, normalized_eps_len: float) -> float:
+        self._ema_eps_len = (1.0 - self._degree) * self._ema_eps_len + self._degree * normalized_eps_len
+
+        if self._ema_eps_len < self._level_down_threshold:
+            self._current_scale *= 1.0 - self._degree
+        elif self._ema_eps_len > self._level_up_threshold:
+            self._current_scale *= 1.0 + self._degree
+
+        self._current_scale = max(self._min_scale, min(1.0, self._current_scale))
+
+        return self._current_scale
+
+
+
+"""TODO: Implement a domain randomization curriculum for the environment."""
+
+
+def dr_curriculum(
+    env: "ManagerBasedRlEnv",
+    env_ids: torch.Tensor | slice,
+) -> dict[str, torch.Tensor]:
+    return {}
