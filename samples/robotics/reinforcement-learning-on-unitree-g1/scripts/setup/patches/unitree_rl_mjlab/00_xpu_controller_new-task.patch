+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Any, Protocol
+
+import torch
+
+if TYPE_CHECKING:
+  from .motion_command import ChainedMotionCommand
+  from .policy_graph import TransitionContext
+
+
+NodeId = str
+
+
+class Policy(Protocol):
+  def __call__(self, obs: Any) -> torch.Tensor: ...
+
+
+class TransitionCondition(Protocol):
+  def __call__(self, context: TransitionContext) -> bool: ...
+
+
+class TransitionAction(Protocol):
+  def observe(self, command: ChainedMotionCommand) -> None: ...
+
+  def apply(self, command: ChainedMotionCommand) -> None: ...
+
+  def reset(self) -> None: ...
+
+
+class TorsoYawReference(Protocol):
+  def observe(self, torso_quat_w: torch.Tensor) -> None: ...
+
+  def resolve(self) -> torch.Tensor: ...
+
+  def reset(self) -> None: ...
+
+
+class MotionCommandAction:
+  """Composable transform applied to motion values exposed by a command."""
+
+  def reset(self, command: ChainedMotionCommand) -> None:
+    del command
+
+  def transform_joint_pos(
+    self, command: ChainedMotionCommand, values: torch.Tensor
+  ) -> torch.Tensor:
+    del command
+    return values
+
+  def transform_joint_vel(
+    self, command: ChainedMotionCommand, values: torch.Tensor
+  ) -> torch.Tensor:
+    del command
+    return values
+
+  def transform_body_pos(
+    self, command: ChainedMotionCommand, values: torch.Tensor
+  ) -> torch.Tensor:
+    del command
+    return values
+
+  def transform_body_quat(
+    self, command: ChainedMotionCommand, values: torch.Tensor
+  ) -> torch.Tensor:
+    del command
+    return values
+
+  def transform_body_lin_vel(
+    self, command: ChainedMotionCommand, values: torch.Tensor
+  ) -> torch.Tensor:
+    del command
+    return values
+
+  def transform_body_ang_vel(
+    self, command: ChainedMotionCommand, values: torch.Tensor
+  ) -> torch.Tensor:
+    del command
+    return values
