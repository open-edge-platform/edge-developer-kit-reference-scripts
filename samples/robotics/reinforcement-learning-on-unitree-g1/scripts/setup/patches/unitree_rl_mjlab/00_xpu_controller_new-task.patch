index 0000000..070c1a0
--- /dev/null
+++ b/controller/policy_graph.py
@@ -0,0 +1,196 @@
+from __future__ import annotations
+
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any, Mapping, Sequence
+
+import torch
+
+from mjlab.tasks.tracking.mdp.commands import MotionLoader
+
+from .actions import AlignTargetYaw, CircularMeanTorsoYaw
+from .conditions import MotionComplete
+from .motion_command import ChainedMotionCommand
+from .types import NodeId, Policy, TransitionAction, TransitionCondition
+
+
+@dataclass(frozen=True)
+class PolicyNode:
+  id: NodeId
+  name: str
+  policy: Policy
+  motion_path: Path
+  motion: MotionLoader
+
+
+@dataclass(frozen=True)
+class TransitionContext:
+  source: PolicyNode
+  step_result: tuple[Any, ...]
+  motion_was_on_final_frame: bool
+  step_count: int
+
+
+@dataclass(frozen=True)
+class PolicyEdge:
+  source: NodeId
+  target: NodeId
+  condition: TransitionCondition
+  priority: int = 0
+  name: str = ""
+  action: TransitionAction | None = None
+
+
+@dataclass(frozen=True)
+class PolicyGraph:
+  nodes: Mapping[NodeId, PolicyNode]
+  edges: tuple[PolicyEdge, ...]
+  start: NodeId
+
+  def __post_init__(self) -> None:
+    if self.start not in self.nodes:
+      raise ValueError(f"Unknown start node: {self.start}")
+    for edge in self.edges:
+      if edge.source not in self.nodes:
+        raise ValueError(f"Unknown edge source: {edge.source}")
+      if edge.target not in self.nodes:
+        raise ValueError(f"Unknown edge target: {edge.target}")
+
+  def outgoing(self, node_id: NodeId) -> tuple[PolicyEdge, ...]:
+    edges = (edge for edge in self.edges if edge.source == node_id)
+    return tuple(sorted(edges, key=lambda edge: edge.priority, reverse=True))
+
+
+class GraphPolicy:
+  def __init__(self, graph: PolicyGraph, command: ChainedMotionCommand) -> None:
+    self._graph = graph
+    self._command = command
+    self._active_node_id = graph.start
+    self._activate_node(graph.start)
+
+  @property
+  def active_node(self) -> PolicyNode:
+    return self._graph.nodes[self._active_node_id]
+
+  @property
+  def active_node_id(self) -> NodeId:
+    return self._active_node_id
+
+  def __call__(self, obs: Any) -> torch.Tensor:
+    return self.active_node.policy(obs)
+
+  def motion_is_on_final_frame(self) -> bool:
+    return bool(
+      torch.any(self._command.time_steps >= self._command.motion.time_step_total - 1)
+    )
+
+  def find_transition(self, context: TransitionContext) -> PolicyEdge | None:
+    for edge in self._graph.outgoing(self._active_node_id):
+      if edge.condition(context):
+        return edge
+    return None
+
+  def observe_transition_actions(self) -> None:
+    for edge in self._graph.outgoing(self._active_node_id):
+      if edge.action is not None:
+        edge.action.observe(self._command)
+
+  def transition(self, edge: PolicyEdge) -> None:
+    if edge.source != self._active_node_id:
+      raise ValueError(f"Edge does not leave active node: {edge.name or edge.source}")
+    source_edges = self._graph.outgoing(self._active_node_id)
+    self._reset_policy(self.active_node.policy)
+    self._activate_node(edge.target)
+    if edge.action is not None:
+      edge.action.apply(self._command)
+    for source_edge in source_edges:
+      if source_edge.action is not None:
+        source_edge.action.reset()
+
+  def reset(self) -> None:
+    for node in self._graph.nodes.values():
+      self._reset_policy(node.policy)
+    for edge in self._graph.edges:
+      if edge.action is not None:
+        edge.action.reset()
+    self._activate_node(self._graph.start)
+
+  def reset_environment(self, env: Any) -> None:
+    self.reset()
+    with self._command.full_reset_enabled():
+      env.reset()
+
+  def _activate_node(self, node_id: NodeId) -> None:
+    node = self._graph.nodes[node_id]
+    self._command.reset_actions()
+    self._active_node_id = node_id
+    self._command.motion = node.motion
+    self._command.cfg.motion_file = str(node.motion_path)
+    self._command.time_steps.zero_()
+    self._command.bin_count = int(
+      node.motion.time_step_total // (1 / self._command._env.step_dt)
+    ) + 1
+    self._command.bin_failed_count = torch.zeros(
+      self._command.bin_count, dtype=torch.float, device=self._command.device
+    )
+    self._command._current_bin_failed = torch.zeros_like(
+      self._command.bin_failed_count
+    )
+    print(f"[INFO]: Active node {node.id}: {node.name} / {node.motion_path.name}")
+
+  @staticmethod
+  def _reset_policy(policy: Policy) -> None:
+    reset_fn = getattr(policy, "reset", None)
+    if reset_fn is not None:
+      reset_fn()
+
+##################################################################################
+### Simpliest torso yaw-aligned, sequential chaining policy
+##################################################################################
+
+def build_sequential_graph(
+  policies: Sequence[Policy],
+  names: Sequence[str],
+  motion_paths: Sequence[Path],
+  command: ChainedMotionCommand,
+  yaw_reference_window: int = 1,
+) -> PolicyGraph:
+  if len(policies) < 2:
+    raise ValueError("A policy graph requires at least two policies.")
+  if len(policies) != len(names) or len(policies) != len(motion_paths):
+    raise ValueError("Policies, names, and motions must have matching lengths.")
+
+  motions = [command.motion]
+  motions.extend(
+    MotionLoader(str(path), command.body_indexes, device=command.device)
+    for path in motion_paths[1:]
+  )
+  joint_shape = motions[0].joint_pos.shape[1:]
+  for path, motion in zip(motion_paths, motions, strict=True):
+    if motion.joint_pos.shape[1:] != joint_shape:
+      raise ValueError(f"Motion has incompatible joint shape: {path}")
+
+  nodes = {
+    f"policy_{index + 1}": PolicyNode(
+      id=f"policy_{index + 1}",
+      name=name,
+      policy=policy,
+      motion_path=motion_path,
+      motion=motion,
+    )
+    for index, (policy, name, motion_path, motion) in enumerate(
+      zip(policies, names, motion_paths, motions, strict=True)
+    )
+  }
+  node_ids = tuple(nodes)
+  edges = tuple(
+    PolicyEdge(
+      source=node_id,
+      target=node_ids[(index + 1) % len(node_ids)],
+      condition=MotionComplete(),
+      name="motion_complete",
+      action=AlignTargetYaw(CircularMeanTorsoYaw(yaw_reference_window)),
+    )
+    for index, node_id in enumerate(node_ids)
+  )
+  return PolicyGraph(nodes=nodes, edges=edges, start=node_ids[0])
