new file mode 100644
index 0000000..20edb37
--- /dev/null
+++ b/scripts/play_chain.py
@@ -0,0 +1,221 @@
+"""Play a looping sequence of same-task RSL-RL policies."""
+
+import os
+import sys
+from dataclasses import asdict, dataclass, fields
+from pathlib import Path
+from typing import Literal
+
+PROJECT_ROOT = Path(__file__).resolve().parents[1]
+if str(PROJECT_ROOT) not in sys.path:
+  sys.path.insert(0, str(PROJECT_ROOT))
+
+import viser
+import torch
+import tyro
+
+from mjlab.envs import ManagerBasedRlEnv
+from mjlab.rl import MjlabOnPolicyRunner, RslRlVecEnvWrapper
+from mjlab.tasks.registry import list_tasks, load_env_cfg, load_rl_cfg, load_runner_cls
+from mjlab.tasks.tracking.mdp import MotionCommandCfg
+from mjlab.utils.torch import (
+  configure_torch_backends,
+  configure_torch_threads,
+  configure_xpu_backends,
+)
+from mjlab.utils.wrappers import VideoRecorder
+
+from controller import (
+  ChainedMotionCommand,
+  ChainedMotionCommandCfg,
+  GraphPolicy,
+  NativeMultiPlayViewer,
+  ViserMultiPlayViewer,
+  build_sequential_graph,
+)
+
+
+@dataclass(frozen=True)
+class PlayConfig:
+  checkpoint_files: tuple[str, ...] = ()
+  """Ordered local checkpoints. At least two are required."""
+  motion_files: tuple[str, ...] = ()
+  """Ordered local motions, one for each checkpoint."""
+  num_envs: int | None = None
+  device: str | None = None
+  video: bool = False
+  video_length: int = 200
+  video_height: int | None = None
+  video_width: int | None = None
+  camera: int | str | None = None
+  viewer: Literal["auto", "native", "viser"] = "auto"
+  port: int = 8000
+  yaw_reference_window: int = 1
+  """Number of recent torso yaw samples used for circular-mean alignment."""
+
+
+def _resolve_paths(paths: tuple[str, ...]) -> tuple[Path, ...]:
+  return tuple(Path(path.strip()).expanduser().resolve() for path in paths)
+
+
+def run_play(task_id: str, cfg: PlayConfig):
+  xpu_available = hasattr(torch, "xpu") and torch.xpu.is_available()
+  device = cfg.device or (
+    "xpu"
+    if xpu_available
+    else ("cuda:0" if torch.cuda.is_available() else "cpu")
+  )
+
+  sim_device = None
+  if device.startswith("xpu"):
+    if not xpu_available:
+      raise RuntimeError("XPU playback requires an available Torch XPU device")
+    import warp as wp
+
+    configure_torch_threads()
+    wp.init()
+    wp.get_device("sycl")
+    configure_xpu_backends()
+    sim_device = "sycl"
+  else:
+    configure_torch_backends()
+
+  if len(cfg.checkpoint_files) < 2:
+    raise ValueError("Provide at least two ordered checkpoints with --checkpoint-files.")
+  if len(cfg.motion_files) != len(cfg.checkpoint_files):
+    raise ValueError(
+      "Provide exactly one --motion-files entry for each --checkpoint-files entry."
+    )
+
+  checkpoint_paths = _resolve_paths(cfg.checkpoint_files)
+  motion_paths = _resolve_paths(cfg.motion_files)
+  missing_paths = [
+    path for path in (*checkpoint_paths, *motion_paths) if not path.is_file()
+  ]
+  if missing_paths:
+    missing = "\n".join(f"  {path}" for path in missing_paths)
+    raise FileNotFoundError(f"Chain files not found:\n{missing}")
+
+  env_cfg = load_env_cfg(task_id, play=True)
+  agent_cfg = load_rl_cfg(task_id)
+
+  env_cfg.terminations = {}
+  print("[INFO]: Terminations disabled to preserve robot state across transitions.")
+
+  is_tracking_task = "motion" in env_cfg.commands and isinstance(
+    env_cfg.commands["motion"], MotionCommandCfg
