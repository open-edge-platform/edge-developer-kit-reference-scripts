+
+  motion_cmd = env_cfg.commands["motion"]
+  assert isinstance(motion_cmd, MotionCommandCfg)
+  motion_cfg_values = {
+    field.name: getattr(motion_cmd, field.name) for field in fields(motion_cmd)
+  }
+  motion_cfg_values["motion_file"] = str(motion_paths[0])
+  motion_cfg_values["sampling_mode"] = "start"
+  env_cfg.commands["motion"] = ChainedMotionCommandCfg(**motion_cfg_values)
+
+  if cfg.num_envs is not None:
+    env_cfg.scene.num_envs = cfg.num_envs
+  if cfg.video_height is not None:
+    env_cfg.viewer.height = cfg.video_height
+  if cfg.video_width is not None:
+    env_cfg.viewer.width = cfg.video_width
+
+  render_mode = "rgb_array" if cfg.video else None
+  env = ManagerBasedRlEnv(cfg=env_cfg, device=device, sim_device=sim_device, render_mode=render_mode)
+
+  if cfg.video:
+    print("[INFO] Recording videos during play")
+    env = VideoRecorder(
+      env,
+      video_folder=checkpoint_paths[0].parent / "videos" / "play_chain",
+      step_trigger=lambda step: step == 0,
+      video_length=cfg.video_length,
+      disable_logger=True,
+    )
+
+  env = RslRlVecEnvWrapper(env, clip_actions=agent_cfg.clip_actions)
+  try:
+    motion_command = env.unwrapped.command_manager.get_term("motion")
+    if not isinstance(motion_command, ChainedMotionCommand):
+      raise TypeError("The task's motion command is not a ChainedMotionCommand.")
+
+    runner_cls = load_runner_cls(task_id) or MjlabOnPolicyRunner
+    runners = []
+    policies = []
+    for checkpoint_path in checkpoint_paths:
+      print(f"[INFO]: Loading checkpoint: {checkpoint_path}")
+      runner = runner_cls(env, asdict(agent_cfg), device=device)
+      runner.load(
+        str(checkpoint_path),
+        load_cfg={"actor": True},
+        strict=True,
+        map_location=device,
+      )
+      runners.append(runner)
+      policies.append(runner.get_inference_policy(device=device))
+
+    graph = build_sequential_graph(
+      policies,
+      [path.name for path in checkpoint_paths],
+      motion_paths,
+      motion_command,
+      yaw_reference_window=cfg.yaw_reference_window,
+    )
+    graph_policy = GraphPolicy(graph, motion_command)
+
+    if cfg.viewer == "auto":
+      has_display = bool(
+        os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")
+      )
+      resolved_viewer = "native" if has_display else "viser"
+    else:
+      resolved_viewer = cfg.viewer
+
+    if resolved_viewer == "native":
+      NativeMultiPlayViewer(env, graph_policy).run()
+    elif resolved_viewer == "viser":
+      viser_server = viser.ViserServer(port=cfg.port, label="mjlab")
+      try:
+        ViserMultiPlayViewer(
+          env, graph_policy, viser_server=viser_server
+        ).run()
+      finally:
+        viser_server.stop()
+    else:
+      raise RuntimeError(f"Unsupported viewer backend: {resolved_viewer}")
+  finally:
+    env.close()
+
+
+def main():
+  # Parse first argument to choose the task.
+  # Import tasks to populate the registry.
+  import mjlab.tasks  # noqa: F401
+  import src.tasks
+
+  all_tasks = list_tasks()
+  chosen_task, remaining_args = tyro.cli(
+    tyro.extras.literal_type_from_choices(all_tasks),
+    add_help=False,
+    return_unknown_args=True,
+    config=mjlab.TYRO_FLAGS,
+  )
+
+  args = tyro.cli(
+    PlayConfig,
+    args=remaining_args,
+    default=PlayConfig(),
+    prog=sys.argv[0] + f" {chosen_task}",
+    config=mjlab.TYRO_FLAGS,
+  )
+  del remaining_args
+
+  run_play(chosen_task, args)
+
+
+if __name__ == "__main__":
+  main()
