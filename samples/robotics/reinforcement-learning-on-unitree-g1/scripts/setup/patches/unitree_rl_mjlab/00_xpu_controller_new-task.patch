+"""
+
+"""
+from __future__ import annotations
+
+from collections import deque
+from dataclasses import dataclass
+
+import torch
+
+from mjlab.utils.lab_api.math import quat_apply, quat_inv, quat_mul, yaw_quat
+
+from .motion_command import ChainedMotionCommand
+from .types import MotionCommandAction, TorsoYawReference
+
+
+class CircularMeanTorsoYaw:
+  def __init__(self, window: int) -> None:
+    if window < 1:
+      raise ValueError("Yaw reference window must be at least 1.")
+    self._samples: deque[torch.Tensor] = deque(maxlen=window)
+
+  def observe(self, torso_quat_w: torch.Tensor) -> None:
+    torso_quat_w = torso_quat_w.detach()
+    qw, qx, qy, qz = torso_quat_w.unbind(dim=-1)
+    yaw = torch.atan2(
+      2 * (qw * qz + qx * qy),
+      1 - 2 * (qy.square() + qz.square()),
+    )
+    self._samples.append(yaw)
+
+  def resolve(self) -> torch.Tensor:
+    if not self._samples:
+      raise RuntimeError("Cannot resolve torso yaw before observing a sample.")
+    samples = torch.stack(tuple(self._samples))
+    yaw = torch.atan2(samples.sin().mean(dim=0), samples.cos().mean(dim=0))
+    result = torch.zeros(yaw.shape + (4,), dtype=yaw.dtype, device=yaw.device)
+    result[..., 0] = torch.cos(yaw / 2)
+    result[..., 3] = torch.sin(yaw / 2)
+    return result
+
+  def reset(self) -> None:
+    self._samples.clear()
+
+
+class LatestTorsoYaw(CircularMeanTorsoYaw):
+  def __init__(self) -> None:
+    super().__init__(window=1)
+
+
+class YawAlignment(MotionCommandAction):
+  def __init__(
+    self, command: ChainedMotionCommand, reference_yaw: torch.Tensor
+  ) -> None:
+    if reference_yaw.shape != (command.num_envs, 4):
+      raise ValueError(
+        "Expected one yaw quaternion per environment, got "
+        f"{reference_yaw.shape}."
+      )
+    target_anchor_yaw = yaw_quat(
+      command.motion.body_quat_w[0, command.motion_anchor_body_index]
+    ).expand_as(reference_yaw)
+    self._offset = quat_mul(reference_yaw, quat_inv(target_anchor_yaw))
+
+  def _expanded_offset(self, values: torch.Tensor) -> torch.Tensor:
+    return self._offset[:, None, :].expand(*values.shape[:-1], 4)
+
+  def transform_body_pos(
+    self, command: ChainedMotionCommand, values: torch.Tensor
+  ) -> torch.Tensor:
+    pivot = command.motion.body_pos_w[0, command.motion_anchor_body_index]
+    pivot = pivot.view(1, 1, 3)
+    return pivot + quat_apply(self._expanded_offset(values), values - pivot)
+
+  def transform_body_quat(
+    self, command: ChainedMotionCommand, values: torch.Tensor
+  ) -> torch.Tensor:
+    del command
+    return quat_mul(self._expanded_offset(values), values)
+
+  def transform_body_lin_vel(
+    self, command: ChainedMotionCommand, values: torch.Tensor
+  ) -> torch.Tensor:
+    del command
+    return quat_apply(self._expanded_offset(values), values)
+
+  def transform_body_ang_vel(
+    self, command: ChainedMotionCommand, values: torch.Tensor
+  ) -> torch.Tensor:
+    del command
+    return quat_apply(self._expanded_offset(values), values)
+
+
+@dataclass
+class AlignTargetYaw:
+  reference: TorsoYawReference
+
+  def observe(self, command: ChainedMotionCommand) -> None:
+    self.reference.observe(command.robot_anchor_quat_w)
+
+  def apply(self, command: ChainedMotionCommand) -> None:
+    command.add_action(YawAlignment(command, self.reference.resolve()))
+
+  def reset(self) -> None:
+    self.reference.reset()
