index 0000000..4185d61
--- /dev/null
+++ b/mujoco_warp/_src/sycl_kernels.py
@@ -0,0 +1,137 @@
+"""Barrier-free kernels for Warp's SYCL device."""
+
+from __future__ import annotations
+
+import warp as wp
+from mujoco_warp._src import types
+
+_JTDAJ_TILE = 16
+
+
+@wp.kernel(enable_backward=False)
+def _update_gradient_jtdaj_flat(
+  nefc_in: wp.array[int],
+  qM_in: wp.array3d[float],
+  efc_J_in: wp.array3d[float],
+  efc_D_in: wp.array2d[float],
+  efc_state_in: wp.array2d[int],
+  ctx_done_in: wp.array[bool],
+  nv_pad: int,
+  tile_count: int,
+  quadratic_state: int,
+  ctx_h_out: wp.array3d[float],
+):
+  worldid, tile_id = wp.tid()
+  if ctx_done_in[worldid]:
+    return
+
+  tile_i = tile_id // tile_count
+  tile_j = tile_id - tile_i * tile_count
+  row_start = tile_i * _JTDAJ_TILE
+  col_start = tile_j * _JTDAJ_TILE
+  rows = wp.min(_JTDAJ_TILE, nv_pad - row_start)
+  cols = wp.min(_JTDAJ_TILE, nv_pad - col_start)
+
+  for i in range(rows):
+    for j in range(cols):
+      ctx_h_out[worldid, row_start + i, col_start + j] = qM_in[
+        worldid, row_start + i, col_start + j
+      ]
+
+  for constraint_id in range(nefc_in[worldid]):
+    d = efc_D_in[worldid, constraint_id]
+    if efc_state_in[worldid, constraint_id] != quadratic_state or d == 0.0:
+      continue
+    for i in range(rows):
+      row_value = efc_J_in[worldid, constraint_id, row_start + i] * d
+      for j in range(cols):
+        ctx_h_out[worldid, row_start + i, col_start + j] += (
+          row_value * efc_J_in[worldid, constraint_id, col_start + j]
+        )
+
+
+def launch_update_gradient_jtdaj(
+  nefc: wp.array,
+  qM: wp.array3d,
+  efc_J: wp.array3d,
+  efc_D: wp.array2d,
+  efc_state: wp.array2d,
+  done: wp.array,
+  h: wp.array3d,
+  nworld: int,
+  nv_pad: int,
+) -> None:
+  tile_count = (nv_pad + _JTDAJ_TILE - 1) // _JTDAJ_TILE
+  wp.launch(
+    _update_gradient_jtdaj_flat,
+    dim=(nworld, tile_count * tile_count),
+    inputs=[
+      nefc,
+      qM,
+      efc_J,
+      efc_D,
+      efc_state,
+      done,
+      nv_pad,
+      tile_count,
+      int(types.ConstraintState.QUADRATIC.value),
+    ],
+    outputs=[h],
+  )
+
+
+@wp.kernel(enable_backward=False)
+def _update_gradient_cholesky_flat(
+  grad_in: wp.array2d[float],
+  h_in: wp.array3d[float],
+  done_in: wp.array[bool],
+  matrix_size: int,
+  factor_out: wp.array3d[float],
+  mgrad_out: wp.array2d[float],
+):
+  worldid = wp.tid()
+  if done_in[worldid]:
+    return
+
+  for i in range(matrix_size):
+    for j in range(i + 1):
+      value = h_in[worldid, i, j]
+      for k in range(j):
+        value -= factor_out[worldid, i, k] * factor_out[worldid, j, k]
+      if i == j:
+        factor_out[worldid, i, j] = wp.sqrt(value)
+      else:
+        factor_out[worldid, i, j] = value / factor_out[worldid, j, j]
+
+  for i in range(matrix_size):
+    value = grad_in[worldid, i]
+    for k in range(i):
+      value -= factor_out[worldid, i, k] * mgrad_out[worldid, k]
+    mgrad_out[worldid, i] = value / factor_out[worldid, i, i]
+
+  for offset in range(matrix_size):
+    i = matrix_size - 1 - offset
+    value = mgrad_out[worldid, i]
+    for k in range(matrix_size - 1 - i):
+      row = matrix_size - 1 - k
+      value -= factor_out[worldid, row, i] * mgrad_out[worldid, row]
+    mgrad_out[worldid, i] = value / factor_out[worldid, i, i]
+
+
+def launch_update_gradient_cholesky(
+  grad: wp.array2d,
+  h: wp.array3d,
+  done: wp.array,
+  mgrad: wp.array2d,
+  nworld: int,
+  matrix_size: int,
+  device: wp.context.Device,
+) -> None:
+  factor = wp.empty_like(h, device=device)
+  wp.launch(
+    _update_gradient_cholesky_flat,
+    dim=nworld,
+    inputs=[grad, h, done, matrix_size],
+    outputs=[factor, mgrad],
+    device=device,
+  )
