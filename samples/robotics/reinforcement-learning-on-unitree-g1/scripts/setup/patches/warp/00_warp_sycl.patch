+extern "C" {
+
+int wp_sycl_bvh_depth(const void* descriptor) {
+    const auto* bvh = static_cast<const BvhDescriptor*>(descriptor);
+    int max_depth = 0;
+    for (int node = 0; node < bvh->num_nodes; ++node) {
+        int depth = 0;
+        for (int parent = bvh->node_parents[node]; parent >= 0; parent = bvh->node_parents[parent]) {
+            if (++depth > bvh->num_nodes) std::abort();
+        }
+        if (depth > max_depth) max_depth = depth;
+    }
+    return max_depth;
+}
+
+void wp_sycl_bvh_refit(void* descriptor, int max_depth) {
+    auto* bvh = static_cast<BvhDescriptor*>(descriptor);
+    if (!bvh || bvh->num_nodes == 0) return;
+    g_last_kernel.store("wp_sycl_bvh_refit");
+    try {
+        the_queue().parallel_for(sycl::range<1>(bvh->num_nodes), [=](sycl::id<1> index) {
+            const int node = index[0];
+            auto& lower = bvh->node_lowers[node];
+            auto& upper = bvh->node_uppers[node];
+            if (!(lower.packed & kLeafBit)) return;
+            float lx = 3.402823466e38f, ly = lx, lz = lx;
+            float ux = -lx, uy = -lx, uz = -lx;
+            for (int position = lower.packed & kNodeIndexMask; position < (upper.packed & kNodeIndexMask); ++position) {
+                const int primitive = bvh->primitive_indices[position];
+                const auto lo = bvh->item_lowers[primitive];
+                const auto hi = bvh->item_uppers[primitive];
+                lx = sycl::fmin(lx, lo.x); ly = sycl::fmin(ly, lo.y); lz = sycl::fmin(lz, lo.z);
+                ux = sycl::fmax(ux, hi.x); uy = sycl::fmax(uy, hi.y); uz = sycl::fmax(uz, hi.z);
+            }
+            lower.x = lx; lower.y = ly; lower.z = lz;
+            upper.x = ux; upper.y = uy; upper.z = uz;
+        });
+
+        for (int level = max_depth; level >= 0; --level) {
+            the_queue().parallel_for(sycl::range<1>(bvh->num_nodes), [=](sycl::id<1> index) {
+                const int node = index[0];
+                auto& lower = bvh->node_lowers[node];
+                auto& upper = bvh->node_uppers[node];
+                if (lower.packed & kLeafBit) return;
+                int depth = 0;
+                for (int parent = bvh->node_parents[node]; parent >= 0; parent = bvh->node_parents[parent]) ++depth;
+                if (depth != level) return;
+                const auto left_lower = bvh->node_lowers[lower.packed & kNodeIndexMask];
+                const auto right_lower = bvh->node_lowers[upper.packed & kNodeIndexMask];
+                const auto left_upper = bvh->node_uppers[lower.packed & kNodeIndexMask];
+                const auto right_upper = bvh->node_uppers[upper.packed & kNodeIndexMask];
+                lower.x = sycl::fmin(left_lower.x, right_lower.x);
+                lower.y = sycl::fmin(left_lower.y, right_lower.y);
+                lower.z = sycl::fmin(left_lower.z, right_lower.z);
+                upper.x = sycl::fmax(left_upper.x, right_upper.x);
+                upper.y = sycl::fmax(left_upper.y, right_upper.y);
+                upper.z = sycl::fmax(left_upper.z, right_upper.z);
+            });
+        }
+    } catch (const sycl::exception& error) {
+        std::fprintf(stderr, "wp_sycl_bvh_refit failed: %s\n", error.what());
+        std::abort();
+    }
+}
