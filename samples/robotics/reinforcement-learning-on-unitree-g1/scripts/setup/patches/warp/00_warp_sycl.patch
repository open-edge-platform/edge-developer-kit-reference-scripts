+struct BvhVec3 { float x, y, z; };
+
+struct BvhDescriptor {
+    BvhNodeHalf* node_lowers;
+    BvhNodeHalf* node_uppers;
+    int* node_parents;
+    int* node_counts;
+    int* primitive_indices;
+    int max_depth, max_nodes, num_nodes, num_leaf_nodes;
+    int* root;
+    BvhVec3* item_lowers;
+    BvhVec3* item_uppers;
+    int* item_groups;
+    int num_items, leaf_size;
+    void* context;
+};
