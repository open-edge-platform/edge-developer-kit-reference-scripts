+#endif
+
 class tile_shared_storage_t {
 private:
 #if !defined(__CUDA_ARCH__)
 #define WP_MAX_CPU_SHARED 256*1024
+// SYCL target: per-task arena carved out of the work-group's local memory
+// (SLM). Intel Arc reports 64 KiB per group; the counter array requested by
+// get_smem_base() takes 1 KiB, leaving this budget for tile storage. Must
+// stay in sync with the SLM capacity of the target GPU.
+#define WP_MAX_SYCL_SHARED 16*1024
 #if defined(WP_ENABLE_TILES_IN_STACK_MEMORY)
     tile_shared_storage_t* old_value;
     unsigned int smem_base[WP_TILE_BLOCK_DIM];
@@ -938,6 +956,13 @@ private:
         return smem_base;
 #elif defined(WP_ENABLE_TILES_IN_STACK_MEMORY)
         return shared_tile_storage->smem_base;
+#elif defined(__SYCL_DEVICE_ONLY__)
+        // SYCL: work-group local memory. Kernel entries launch one work-item
+        // per group, so the counter is private to the current task. The
