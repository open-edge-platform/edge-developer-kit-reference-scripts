+class FunctorArg:
+    """Renders a warp function argument as a stateless generic C++ lambda.
+
+    SPIR-V (SYCL device code) rejects calls through function pointers, and
+    tile_map()'s op argument is otherwise emitted as a bare function symbol,
+    which decays to a pointer inside device code. The lambda closure calls
+    the target directly, so it is inlined everywhere (CPU and CUDA compile
+    it just as happily). The adjoint variant calls the 'adj_'-prefixed
+    symbol, mirroring how format_args() renders plain function arguments.
+    """
+
+    def __init__(self, func):
+        self.func = func
+
+    def emit(self, prefix: str = "var"):
+        if "adj" in prefix:
+            sym = f"{self.func.namespace}adj_{self.func.native_func}"
+        else:
+            sym = f"{self.func.namespace}{self.func.native_func}"
+        return f"[](auto&&... _wp_f){{ return {sym}(_wp_f...); }}"
+
