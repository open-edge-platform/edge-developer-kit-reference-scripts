{
  "name": "@mujoco-studio/web",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "ensure:local-env": "node scripts/ensure-local-env.mjs",
    "sync:mujoco": "node scripts/sync-mujoco-runtime.mjs",
    "predev": "npm run ensure:local-env && npm run sync:mujoco",
    "dev": "node scripts/run-next.mjs dev",
    "prestart": "npm run ensure:local-env && NODE_ENV=development npm run payload -- bootstrap-local-db",
    "prebuild": "npm run sync:mujoco",
    "build": "next build",
    "start": "node scripts/run-next.mjs start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "payload": "payload",
    "generate:types": "payload generate:types && prettier --write ../../payload/src/payload-types.ts",
    "generate:importmap": "payload generate:importmap"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@noble/hashes": "^1.8.0",
    "@mujoco-studio/mujoco": "*",
    "@mujoco-studio/payload": "*",
    "@mujoco-studio/scene": "*",
    "@mujoco-studio/types": "*",
    "@mujoco-studio/ui": "*",
    "@mujoco/mujoco": "^3.11.0",
    "@payloadcms/next": "3.90.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "@sparkjsdev/spark": "^2.1.0",
    "@tanstack/react-query": "^5.101.4",
    "@types/busboy": "^1.5.4",
    "busboy": "^1.6.0",
    "fflate": "^0.8.2",
    "graphql": "^16.8.1",
    "next": "16.4.5",
    "payload": "3.90.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.3",
    "three": "^0.185.1",
    "zeromq": "^6.6.0",
    "zustand": "^5.0.14",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@mujoco-studio/eslint-config": "*",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "eslint": "^9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
