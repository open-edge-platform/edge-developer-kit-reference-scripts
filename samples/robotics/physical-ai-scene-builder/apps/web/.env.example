# Filled from the root .env PostgreSQL settings on first start.
DATABASE_URI=postgres://localhost:5432/mujoco_studio
# Generated on first start when left empty.
PAYLOAD_SECRET=
# Network settings live in the root .env: BIND_ADDRESS=127.0.0.1 and PORT=3000.
# Public URLs are derived from requests; no LAN IP needs to be configured here.
# Runtime data: uploads, artifacts, recordings, and datasets. Relative paths resolve from apps/web,
# so the default is the repository's data/ folder. Keep it outside apps/web.
ROBOTIC_STUDIO_DATA_DIR=../../data
# Optional overrides for the teleoperation native process. By default it uses uv with
# integrations/python/uv.lock.
# ROBOTIC_STUDIO_UV=/absolute/path/to/uv
# ROBOTIC_STUDIO_PYTHON=/absolute/path/to/python
# Intel XPU used by Generate/Evaluate workers to composite a splat backdrop (xpu or xpu:N).
# ROBOTIC_STUDIO_XPU_DEVICE=xpu:0
# Generate and Simulate share control 8080, publisher 8081, and browser stream 8082.
# Set one base port when another local service owns that range.
# ROBOTIC_STUDIO_TELEOPERATION_BASE_PORT=8080
# Optional image-to-3D pipeline (see services/README.md).
# ROBOTIC_STUDIO_TRELLIS_API_URL=http://127.0.0.1:8000
# ROBOTIC_STUDIO_TRELLIS_PATH=/absolute/path/to/services/trellis2
# ROBOTIC_STUDIO_TRELLIS_TIMEOUT_MS=600000
# ROBOTIC_STUDIO_GLB2OBJ_PATH=/absolute/path/to/services/glb2obj
# ROBOTIC_STUDIO_GLB2OBJ_PYTHON=/absolute/path/to/python
# ROBOTIC_STUDIO_OBJ2MJCF=/absolute/path/to/obj2mjcf
