+from pathlib import Path
+from collections import defaultdict
+import os
+import struct
+import subprocess  # nosec B404
+import tempfile
+
+import numpy as np
+import torch
+
+
+def _fill_small_boundary_loops(mesh, max_perimeter=3e-2):
+    from trimesh.grouping import group_rows
+
+    boundary_indices = group_rows(mesh.edges_sorted, require_count=1)
+    if len(boundary_indices) == 0:
+        return []
+
+    boundary_edges = mesh.edges[boundary_indices]
+    adjacency = defaultdict(list)
+    directed_edges = {}
+    for edge_index, (start, end) in enumerate(boundary_edges):
+        start, end = int(start), int(end)
+        adjacency[start].append((end, edge_index))
+        adjacency[end].append((start, edge_index))
+        directed_edges[frozenset((start, end))] = (start, end)
+
+    vertices = mesh.vertices
+    visited_edges = set()
+    new_vertices = []
+    new_faces = []
+    centroid_sources = []
+
+    for seed_edge, (seed_start, seed_end) in enumerate(boundary_edges):
+        if seed_edge in visited_edges:
+            continue
+        seed_start, seed_end = int(seed_start), int(seed_end)
+        component_edges = set()
+        component_vertices = set()
+        stack = [seed_start]
+        while stack:
+            vertex = stack.pop()
+            if vertex in component_vertices:
+                continue
+            component_vertices.add(vertex)
+            for neighbor, edge_index in adjacency[vertex]:
+                component_edges.add(edge_index)
+                if neighbor not in component_vertices:
+                    stack.append(neighbor)
+        visited_edges.update(component_edges)
+
+        if len(component_edges) != len(component_vertices) or any(
+            len(adjacency[vertex]) != 2 for vertex in component_vertices
+        ):
+            continue
+
+        loop = [seed_start]
+        previous_edge = seed_edge
+        current = seed_end
+        while current != seed_start and len(loop) <= len(component_vertices):
+            loop.append(current)
+            choices = [
+                (neighbor, edge_index)
+                for neighbor, edge_index in adjacency[current]
+                if edge_index != previous_edge
+            ]
+            if len(choices) != 1:
+                break
+            current, previous_edge = choices[0]
+        if current != seed_start or len(loop) != len(component_vertices):
+            continue
+
+        loop_points = vertices[loop]
+        perimeter = np.linalg.norm(
+            loop_points - np.roll(loop_points, -1, axis=0), axis=1
+        ).sum()
+        if perimeter >= max_perimeter:
+            continue
+
+        centroid_index = len(vertices) + len(new_vertices)
+        new_vertices.append(loop_points.mean(axis=0))
+        centroid_sources.append((centroid_index, loop))
+        for index, start in enumerate(loop):
+            end = loop[(index + 1) % len(loop)]
+            edge_start, edge_end = directed_edges[frozenset((start, end))]
+            new_faces.append((edge_end, edge_start, centroid_index))
+
+    if new_faces:
+        mesh.vertices = np.vstack([vertices, np.asarray(new_vertices)])
+        mesh.faces = np.vstack([mesh.faces, np.asarray(new_faces, dtype=mesh.faces.dtype)])
+    return centroid_sources
+
+
+def _rasterize_uv_attributes(uvs, faces, attributes, resolution):
+    from numba import njit
+
+    @njit
+    def rasterize(uv, triangles, values, size):
+        image = np.zeros((size, size, values.shape[1]), dtype=np.float32)
+        mask = np.zeros((size, size), dtype=np.uint8)
+        for face_index in range(triangles.shape[0]):
+            indices = triangles[face_index]
+            uv0, uv1, uv2 = uv[indices[0]], uv[indices[1]], uv[indices[2]]
+            x0, y0 = uv0[0] * size - 0.5, (1.0 - uv0[1]) * size - 0.5
+            x1, y1 = uv1[0] * size - 0.5, (1.0 - uv1[1]) * size - 0.5
+            x2, y2 = uv2[0] * size - 0.5, (1.0 - uv2[1]) * size - 0.5
+            min_x = max(0, int(np.floor(min(x0, x1, x2))))
+            max_x = min(size - 1, int(np.ceil(max(x0, x1, x2))))
+            min_y = max(0, int(np.floor(min(y0, y1, y2))))
+            max_y = min(size - 1, int(np.ceil(max(y0, y1, y2))))
+            denominator = (y1 - y2) * (x0 - x2) + (x2 - x1) * (y0 - y2)
+            if abs(denominator) < 1e-12:
+                continue
+            for py in range(min_y, max_y + 1):
+                for px in range(min_x, max_x + 1):
+                    w0 = ((y1 - y2) * (px - x2) + (x2 - x1) * (py - y2)) / denominator
+                    w1 = ((y2 - y0) * (px - x2) + (x0 - x2) * (py - y2)) / denominator
+                    w2 = 1.0 - w0 - w1
+                    if w0 >= -1e-5 and w1 >= -1e-5 and w2 >= -1e-5:
+                        for channel in range(values.shape[1]):
+                            image[py, px, channel] = (
+                                w0 * values[indices[0], channel]
+                                + w1 * values[indices[1], channel]
+                                + w2 * values[indices[2], channel]
+                            )
+                        mask[py, px] = 255
+        return image, mask
+
+    return rasterize(
+        np.ascontiguousarray(uvs, dtype=np.float32),
+        np.ascontiguousarray(faces, dtype=np.int64),
+        np.ascontiguousarray(attributes, dtype=np.float32),
+        int(resolution),
+    )
+
+
+def _native_xpu_postprocess(root):
+    configured = os.environ.get('TRELLIS_XPU_POSTPROCESS_BIN')
+    executable = Path(configured) if configured else root / 'trellis.cpp' / 'build-xpu-postprocess' / 'trellis-xpu-postprocess'
+    if executable.is_file():
+        return executable
+
+    source_dir = root / 'trellis.cpp' / 'xpu_postprocess'
+    build_dir = root / 'trellis.cpp' / 'build-xpu-postprocess'
+    try:
+        subprocess.run(
+            ['cmake', '-S', str(source_dir), '-B', str(build_dir), '-DCMAKE_BUILD_TYPE=Release'],
+            check=True,
+        )
+        subprocess.run(
+            ['cmake', '--build', str(build_dir), '--target', 'trellis-xpu-postprocess', '--parallel', '4'],
+            check=True,
+        )
+    except FileNotFoundError as error:
+        raise RuntimeError('CMake is required to build the TRELLIS.2 CPU postprocessor') from error
+    executable = build_dir / 'trellis-xpu-postprocess'
+    if not executable.is_file():
+        raise RuntimeError(f'TRELLIS.2 CPU postprocessor was not built: {executable}')
+    return executable
+
+
+def export_mesh_with_voxel_to_glb(
+    mesh, output_path, texture_size=4096, max_faces=500_000, remesh_band=1,
+    simulation_output_path=None,
+):
+    """Run TRELLIS.2's native CPU postprocess and bake decoded sparse PBR data."""
+    import numpy as np
+
+    if not all(key in mesh.layout for key in ('base_color', 'metallic', 'roughness', 'alpha')):
+        raise ValueError('XPU GLB export requires the six-channel TRELLIS.2 PBR layout')
+    vertices = np.ascontiguousarray(mesh.vertices.detach().float().cpu().numpy(), dtype=np.float32)
+    faces = np.ascontiguousarray(mesh.faces.detach().to(device='cpu', dtype=torch.int32).numpy())
+    coords = np.ascontiguousarray(mesh.coords.detach().to(device='cpu', dtype=torch.int32).numpy())
+    attributes = np.ascontiguousarray(mesh.attrs.detach().float().cpu().numpy(), dtype=np.float32)
+    if vertices.ndim != 2 or vertices.shape[1] != 3 or faces.ndim != 2 or faces.shape[1] != 3:
+        raise ValueError('Mesh vertices and faces must have shape (N, 3) and (M, 3)')
+    if coords.ndim != 2 or coords.shape[1] != 3 or attributes.shape != (len(coords), 6):
+        raise ValueError('Sparse PBR coordinates and attributes must have shapes (N, 3) and (N, 6)')
+    resolution = int(round(1.0 / float(mesh.voxel_size)))
+    if resolution < 32 or texture_size <= 0 or remesh_band <= 0 or max_faces < 0:
+        raise ValueError('Invalid resolution, texture size, remesh band, or face target')
+
+    output_path = Path(output_path).resolve()
+    output_path.parent.mkdir(parents=True, exist_ok=True)
+    root = Path(__file__).resolve().parents[2]
+    executable = _native_xpu_postprocess(root)
+    with tempfile.TemporaryDirectory(prefix='trellis-xpu-post-') as temp_dir:
+        dump_path = Path(temp_dir) / 'decoded.post'
+        with dump_path.open('wb') as dump:
+            dump.write(struct.pack('<4i', len(vertices), len(faces), len(coords), resolution))
+            vertices.tofile(dump)
+            faces.tofile(dump)
+            coords.tofile(dump)
+            attributes.tofile(dump)
+        command = [
+            str(executable), str(dump_path), str(output_path),
+            '--faces', str(max_faces), '--atlas', str(texture_size), '--band', str(remesh_band),
+        ]
+        if simulation_output_path is not None:
+            command.extend(['--simulation-output', str(Path(simulation_output_path).resolve())])
+        subprocess.run(command, check=True)
+    return str(output_path)
