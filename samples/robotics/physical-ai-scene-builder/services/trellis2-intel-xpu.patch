index 0000000..d93d125
--- /dev/null
+++ b/trellis2/modules/sparse/conv/conv_none.py
@@ -0,0 +1,97 @@
+import itertools
+import math
+
+import torch
+import torch.nn as nn
+import torch.nn.functional as F
+
+from .. import SparseTensor
+
+
+def _triple(value):
+    return tuple(value) if isinstance(value, (list, tuple)) else (value,) * 3
+
+
+def sparse_conv3d_init(self, in_channels, out_channels, kernel_size, stride=1, dilation=1, padding=None, bias=True, indice_key=None):
+    self.kernel_size = _triple(kernel_size)
+    self.stride = _triple(stride)
+    self.dilation = _triple(dilation)
+    if self.stride != (1, 1, 1) or padding is not None:
+        raise NotImplementedError('The PyTorch sparse backend supports submanifold convolutions only.')
+    if any(size % 2 == 0 for size in self.kernel_size):
+        raise ValueError('Submanifold convolution requires odd kernel sizes.')
+
+    self.weight = nn.Parameter(torch.empty(out_channels, in_channels, *self.kernel_size))
+    if bias:
+        self.bias = nn.Parameter(torch.empty(out_channels))
+    else:
+        self.register_parameter('bias', None)
+
+    nn.init.kaiming_uniform_(self.weight, a=math.sqrt(5))
+    if self.bias is not None:
+        fan_in = in_channels * math.prod(self.kernel_size)
+        bound = 1 / math.sqrt(fan_in)
+        nn.init.uniform_(self.bias, -bound, bound)
+    self.weight = nn.Parameter(self.weight.permute(0, 2, 3, 4, 1).contiguous())
+
+
+def _build_neighbor_map(x, kernel_size, dilation):
+    coords = x.coords.to(torch.int64)
+    spatial_shape = tuple(int(size) for size in x.spatial_shape)
+    size_x, size_y, size_z = spatial_shape
+
+    def encode(coordinate):
+        return (((coordinate[:, 0] * size_x + coordinate[:, 1]) * size_y + coordinate[:, 2]) * size_z + coordinate[:, 3])
+
+    sorted_keys, order = torch.sort(encode(coords))
+    neighbor_map = []
+    centers = coords[:, 1:]
+    for kernel_index in itertools.product(*(range(size) for size in kernel_size)):
+        offsets = tuple((index - size // 2) * step for index, size, step in zip(kernel_index, kernel_size, dilation))
+        if offsets == (0, 0, 0):
+            neighbor_map.append((kernel_index, torch.arange(coords.shape[0], device=coords.device), torch.arange(coords.shape[0], device=coords.device)))
+            continue
+
+        neighbor_coords = centers + torch.tensor(offsets, device=coords.device, dtype=coords.dtype)
+        in_bounds = (
+            (neighbor_coords >= 0)
+            & (neighbor_coords < torch.tensor(spatial_shape, device=coords.device, dtype=coords.dtype))
+        ).all(dim=1)
+        query_coords = torch.cat((coords[:, :1], neighbor_coords), dim=1)
+        query_keys = encode(query_coords).contiguous()
+        positions = torch.searchsorted(sorted_keys, query_keys).clamp(max=sorted_keys.shape[0] - 1)
+        valid = in_bounds & (sorted_keys[positions] == query_keys)
+        destinations = valid.nonzero(as_tuple=False).flatten()
+        sources = order[positions[destinations]]
+        neighbor_map.append((kernel_index, destinations, sources))
+    return neighbor_map
+
+
+def sparse_conv3d_forward(self, x: SparseTensor) -> SparseTensor:
+    if x.feats.ndim != 2:
+        raise ValueError(f'Expected 2D sparse features [N, C], got {tuple(x.feats.shape)}')
+
+    cache_key = f'TorchSubMConv3d_neighbor_cache_{self.kernel_size}_dilation{self.dilation}'
+    neighbor_map = x.get_spatial_cache(cache_key)
+    if neighbor_map is None:
+        neighbor_map = _build_neighbor_map(x, self.kernel_size, self.dilation)
+        x.register_spatial_cache(cache_key, neighbor_map)
+
+    out = x.feats.new_zeros((x.feats.shape[0], self.weight.shape[0]))
+    if self.bias is not None:
+        out = out + self.bias
+    for kernel_index, destinations, sources in neighbor_map:
+        if destinations.numel() == 0:
+            continue
+        kernel_weight = self.weight[:, kernel_index[0], kernel_index[1], kernel_index[2], :]
+        contribution = F.linear(x.feats[sources], kernel_weight)
+        out = out.index_add(0, destinations, contribution)
+    return x.replace(out)
+
+
+def sparse_inverse_conv3d_init(self, *args, **kwargs):
+    raise NotImplementedError('SparseInverseConv3d is not supported by the PyTorch sparse backend.')
+
+
+def sparse_inverse_conv3d_forward(self, x: SparseTensor) -> SparseTensor:
+    raise NotImplementedError('SparseInverseConv3d is not supported by the PyTorch sparse backend.')
