diff --git a/trellis.cpp/xpu_postprocess/main.cpp b/trellis.cpp/xpu_postprocess/main.cpp
new file mode 100644
index 0000000..3efd3a0
--- /dev/null
+++ b/trellis.cpp/xpu_postprocess/main.cpp
@@ -0,0 +1,205 @@
+#include "mesh_glb.h"
+#include "remesh_dc.h"
+#include "tri_bvh.h"
+#include "uv_bake.h"
+
+#include <array>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <fstream>
+#include <limits>
+#include <string>
+#include <vector>
+
+namespace {
+using Clock = std::chrono::steady_clock;
+
+double seconds_since(Clock::time_point start) {
+    return std::chrono::duration<double>(Clock::now() - start).count();
+}
+
+template <typename T>
+bool read_exact(std::ifstream& input, T* data, size_t count) {
+    if (count > static_cast<size_t>(std::numeric_limits<std::streamsize>::max()) / sizeof(T))
+        return false;
+    input.read(reinterpret_cast<char*>(data), static_cast<std::streamsize>(count * sizeof(T)));
+    return input.good();
+}
+
+bool parse_nonnegative(const char* value, int& output) {
+    char* end = nullptr;
+    const long parsed = std::strtol(value, &end, 10);
+    if (end == value || *end || parsed < 0 || parsed > std::numeric_limits<int>::max())
+        return false;
+    output = static_cast<int>(parsed);
+    return true;
+}
+
+void usage() {
+    std::fprintf(stderr,
+        "usage: trellis-xpu-postprocess input.post output.glb [--faces N] [--atlas N] [--band N] [--simulation-output output.glb]\n");
+}
+}  // namespace
+
+int main(int argc, char** argv) {
+    if (argc < 3) {
+        usage();
+        return 2;
+    }
+    int faces_target = 1000000;
+    int atlas_size = 4096;
+    int band = 1;
+    std::string simulation_output;
+    for (int i = 3; i < argc; ++i) {
+        const std::string option = argv[i];
+        if (option == "--simulation-output" && i + 1 < argc) {
+            simulation_output = argv[++i];
+            if (simulation_output == argv[2]) {
+                usage();
+                return 2;
+            }
+            continue;
+        }
+        int* target = nullptr;
+        if (option == "--faces") target = &faces_target;
+        else if (option == "--atlas") target = &atlas_size;
+        else if (option == "--band") target = &band;
+        if (!target || i + 1 >= argc || !parse_nonnegative(argv[++i], *target) ||
+            (target != &faces_target && *target == 0)) {
+            usage();
+            return 2;
+        }
+    }
+
+    std::ifstream input(argv[1], std::ios::binary);
+    if (!input) {
+        std::fprintf(stderr, "cannot open input POST: %s\n", argv[1]);
+        return 1;
+    }
+    int32_t header[4]{};
+    if (!read_exact(input, header, 4)) {
+        std::fprintf(stderr, "invalid input POST header\n");
+        return 1;
+    }
+    const int vertices_count = header[0];
+    const int faces_count = header[1];
+    const int voxels_count = header[2];
+    const int resolution = header[3];
+    if (vertices_count <= 0 || faces_count <= 0 || voxels_count <= 0 || resolution < 32 ||
+        resolution > 1536) {
+        std::fprintf(stderr, "invalid input POST dimensions\n");
+        return 1;
+    }
+
+    std::vector<float> vertices(static_cast<size_t>(vertices_count) * 3);
+    std::vector<int32_t> faces(static_cast<size_t>(faces_count) * 3);
+    std::vector<std::array<int, 3>> coords(static_cast<size_t>(voxels_count));
+    std::vector<float> pbr(static_cast<size_t>(voxels_count) * 6);
+    if (!read_exact(input, vertices.data(), vertices.size()) ||
+        !read_exact(input, faces.data(), faces.size()) ||
+        !read_exact(input, reinterpret_cast<int32_t*>(coords.data()), coords.size() * 3) ||
+        !read_exact(input, pbr.data(), pbr.size()) || input.peek() != std::char_traits<char>::eof()) {
+        std::fprintf(stderr, "truncated or malformed input POST\n");
+        return 1;
+    }
+    std::printf("Loaded decoded mesh: %d vertices, %d faces, %d PBR voxels at res %d\n",
+                vertices_count, faces_count, voxels_count, resolution);
+
+    auto stage = Clock::now();
+    trellis::weld_vertices(vertices, faces, nullptr, 1.0f / (resolution * 8.0f));
+    const int filled_before = trellis::fill_holes(vertices, faces, 3e-2f);
+    std::printf("Initial cleanup: welded mesh, filled %d holes (%.2fs)\n",
+                filled_before, seconds_since(stage));
+
+    stage = Clock::now();
+    trellis::TriBvh source_bvh = trellis::TriBvh::build(
+        vertices.data(), static_cast<int64_t>(vertices.size() / 3),
+        faces.data(), static_cast<int64_t>(faces.size() / 3));
+    std::printf("Built source BVH (%.2fs)\n", seconds_since(stage));
+
+    stage = Clock::now();
+    trellis::Mesh remeshed = trellis::remesh_narrow_band_dc(
+        vertices.data(), static_cast<int64_t>(vertices.size() / 3),
+        faces.data(), static_cast<int64_t>(faces.size() / 3), source_bvh,
+        resolution, band, 0.0f);
+    if (remeshed.F() > 0) {
+        trellis::clean_mesh(remeshed.V(), remeshed.faces);
+    } else {
+        remeshed.verts = vertices;
+        remeshed.faces = faces;
+        std::fprintf(stderr, "Dual Contouring returned no faces; keeping cleaned source geometry\n");
+    }
+    std::printf("Dual Contouring: %zu vertices, %zu faces (%.2fs)\n",
+                remeshed.verts.size() / 3, remeshed.faces.size() / 3, seconds_since(stage));
+
+    const auto export_profile = [&](const char* output, int face_limit, int texture_size) {
+        auto stage = Clock::now();
+        std::vector<float> simplified_vertices;
+        std::vector<int32_t> simplified_faces;
+        if (face_limit > 0) {
+            trellis::decimate_qem(remeshed.verts, static_cast<int>(remeshed.verts.size() / 3),
+                                  remeshed.faces, static_cast<int>(remeshed.faces.size() / 3),
+                                  face_limit, simplified_vertices, simplified_faces);
+        } else {
+            simplified_vertices = remeshed.verts;
+            simplified_faces = remeshed.faces;
+        }
+        trellis::remove_duplicate_faces(simplified_faces);
+        trellis::clean_mesh(static_cast<int>(simplified_vertices.size() / 3), simplified_faces);
+        trellis::repair_non_manifold_edges(simplified_vertices, simplified_faces);
+        trellis::drop_small_components_by_area(simplified_vertices, simplified_faces, 1e-5f);
+        trellis::weld_vertices(simplified_vertices, simplified_faces, nullptr,
+                               1.0f / (resolution * 8.0f));
+        trellis::fill_holes(simplified_vertices, simplified_faces, 3e-2f);
+        if (face_limit > 0 && simplified_faces.size() / 3 > static_cast<size_t>(face_limit)) {
+            std::vector<float> limited_vertices;
+            std::vector<int32_t> limited_faces;
+            trellis::decimate_qem(simplified_vertices, static_cast<int>(simplified_vertices.size() / 3),
+                                  simplified_faces, static_cast<int>(simplified_faces.size() / 3),
+                                  face_limit, limited_vertices, limited_faces);
+            simplified_vertices = std::move(limited_vertices);
+            simplified_faces = std::move(limited_faces);
+        }
+        if (simplified_faces.empty() ||
+            (face_limit > 0 && simplified_faces.size() / 3 > static_cast<size_t>(face_limit))) {
+            std::fprintf(stderr, "mesh could not meet the face budget for %s\n", output);
+            return false;
+        }
+        std::printf("Simplified mesh: %zu vertices, %zu faces (%.2fs)\n",
+                    simplified_vertices.size() / 3, simplified_faces.size() / 3, seconds_since(stage));
+
+        stage = Clock::now();
+        const trellis::VoxelPbr voxel_pbr{&coords, &pbr, resolution, &source_bvh, true};
+        const std::vector<float> no_vertex_attributes;
+        trellis::BakedMesh baked = trellis::uv_bake(
+            simplified_vertices, static_cast<int>(simplified_vertices.size() / 3),
+            simplified_faces, static_cast<int>(simplified_faces.size() / 3),
+            no_vertex_attributes, texture_size, &voxel_pbr);
+        if (!baked.ok()) {
+            baked = trellis::uv_chart_project(
+                simplified_vertices, static_cast<int>(simplified_vertices.size() / 3),
+                simplified_faces, static_cast<int>(simplified_faces.size() / 3),
+                no_vertex_attributes, texture_size, &voxel_pbr);
+        }
+        if (!baked.ok()) {
+            std::fprintf(stderr, "UV unwrap and bake failed\n");
+            return false;
+        }
+        if (!trellis::write_glb_textured(output, baked.verts.data(),
+                static_cast<int64_t>(baked.verts.size() / 3), baked.uv.data(),
+                baked.faces.data(), static_cast<int64_t>(baked.faces.size() / 3),
+                baked.base.data(), baked.mr.data(), baked.T, false)) {
+            std::fprintf(stderr, "failed to write GLB: %s\n", output);
+            return false;
+        }
+        std::printf("Baked %d x %d atlas and wrote %s (%.2fs)\n",
+                    baked.T, baked.T, output, seconds_since(stage));
+        return true;
+    };
+    if (!export_profile(argv[2], faces_target, atlas_size)) return 1;
+    if (!simulation_output.empty() && !export_profile(simulation_output.c_str(), 5000, 512))
+        return 1;
+    return 0;
+}
