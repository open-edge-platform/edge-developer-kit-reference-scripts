+++ b/test_postprocess.py
@@ -0,0 +1,55 @@
+# Copyright (C) 2026 Intel Corporation
+# SPDX-License-Identifier: Apache-2.0
+
+import struct
+import subprocess  # nosec B404
+import tempfile
+import unittest
+from pathlib import Path
+
+import numpy as np
+import trimesh
+
+
+ROOT = Path(__file__).resolve().parent
+BINARY = ROOT / "trellis.cpp/build-xpu-postprocess/trellis-xpu-postprocess"
+
+
+@unittest.skipUnless(BINARY.is_file(), "Build the native XPU postprocessor first.")
+class SimulationProfileTests(unittest.TestCase):
+    def test_preserves_source_and_bakes_a_bounded_simulation_mesh(self):
+        mesh = trimesh.creation.icosphere(subdivisions=5, radius=0.4)
+        resolution = 128
+        coords = np.indices((resolution,) * 3, dtype=np.int32).reshape(3, -1).T
+        distance = np.linalg.norm((coords + 0.5) / resolution - 0.5, axis=1)
+        coords = np.ascontiguousarray(coords[(distance > 0.35) & (distance < 0.45)])
+        pbr = np.tile(np.array([0.2, 0.6, 0.8, 0.0, 0.8, 1.0], dtype=np.float32), (len(coords), 1))
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            dump = root / "mesh.post"
+            source = root / "source.glb"
+            simulation = root / "simulation.glb"
+            with dump.open("wb") as stream:
+                stream.write(struct.pack("<4i", len(mesh.vertices), len(mesh.faces), len(coords), resolution))
+                np.asarray(mesh.vertices, dtype=np.float32).tofile(stream)
+                np.asarray(mesh.faces, dtype=np.int32).tofile(stream)
+                coords.tofile(stream)
+                pbr.tofile(stream)
+            subprocess.run(
+                [str(BINARY), str(dump), str(source), "--faces", "500000",
+                 "--atlas", "4096", "--simulation-output", str(simulation)],
+                check=True, timeout=180, capture_output=True,
+            )
+            original = trimesh.load(source, force="mesh")
+            optimized = trimesh.load(simulation, force="mesh")
+            self.assertGreater(len(original.faces), 20_000)
+            self.assertGreater(len(optimized.faces), 0)
+            self.assertLessEqual(len(optimized.faces), 5_000)
+            self.assertEqual(original.visual.material.baseColorTexture.size, (4096, 4096))
+            self.assertEqual(optimized.visual.material.baseColorTexture.size, (512, 512))
+            self.assertEqual(len(optimized.visual.uv), len(optimized.vertices))
+            np.testing.assert_allclose(optimized.bounds, original.bounds, atol=0.02)
+
+
+if __name__ == "__main__":
+    unittest.main()
