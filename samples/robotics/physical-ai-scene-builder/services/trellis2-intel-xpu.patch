@@ -0,0 +1,33 @@
+import os
+import warnings
+
+import torch
+
+
+def resolve_device(device=None) -> torch.device:
+    """Resolve a requested device or choose an available accelerator."""
+    requested = device or os.environ.get('TRELLIS_DEVICE', 'auto')
+    if requested != 'auto':
+        resolved = torch.device(requested)
+        if resolved.type == 'cuda' and not torch.cuda.is_available():
+            warnings.warn(f"Requested device '{resolved}' is unavailable; falling back to CPU.", RuntimeWarning)
+            return torch.device('cpu')
+        if resolved.type == 'xpu' and (not hasattr(torch, 'xpu') or not torch.xpu.is_available()):
+            warnings.warn(f"Requested device '{resolved}' is unavailable; falling back to CPU.", RuntimeWarning)
+            return torch.device('cpu')
+        return resolved
+
+    if torch.cuda.is_available():
+        return torch.device('cuda')
+    if hasattr(torch, 'xpu') and torch.xpu.is_available():
+        return torch.device('xpu')
+    return torch.device('cpu')
+
+
+def device_count(device=None) -> int:
+    resolved = resolve_device(device)
+    if resolved.type == 'cuda':
+        return torch.cuda.device_count()
+    if resolved.type == 'xpu':
+        return torch.xpu.device_count()
+    return 1
