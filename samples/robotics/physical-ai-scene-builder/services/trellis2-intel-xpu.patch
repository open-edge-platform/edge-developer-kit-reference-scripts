--- /dev/null
+++ b/trellis2_api.py
@@ -0,0 +1,147 @@
+# Copyright (C) 2026 Intel Corporation
+# SPDX-License-Identifier: Apache-2.0
+
+import asyncio
+import os
+import sys
+from contextlib import asynccontextmanager
+from datetime import datetime
+from io import BytesIO
+from pathlib import Path
+from typing import Literal
+from uuid import uuid4
+
+O_VOXEL_SOURCE = Path(__file__).resolve().parent / "o-voxel"
+if str(O_VOXEL_SOURCE) not in sys.path:
+    sys.path.insert(0, str(O_VOXEL_SOURCE))
+
+os.environ.setdefault("OPENCV_IO_ENABLE_OPENEXR", "1")
+os.environ.setdefault("SPARSE_CONV_BACKEND", "none")
+os.environ.setdefault("ATTN_BACKEND", "sdpa")
+os.environ.setdefault("SPARSE_ATTN_BACKEND", "sdpa")
+os.environ.setdefault("TRELLIS_REMBG_MODEL", "ZhengPeng7/BiRefNet")
+if os.environ.get("TRELLIS_DEVICE", "auto") != "cpu":
+    os.environ.setdefault("PYTORCH_CUDA_ALLOC_CONF", "expandable_segments:True")
+
+from fastapi import FastAPI, File, HTTPException, Query, Request, UploadFile
+from starlette.responses import FileResponse
+from PIL import Image, UnidentifiedImageError
+from starlette.concurrency import run_in_threadpool
+
+
+@asynccontextmanager
+async def lifespan(app: FastAPI):
+    from trellis2.pipelines import Trellis2ImageTo3DPipeline
+    from trellis2.utils.device import resolve_device
+
+    device = resolve_device()
+    app.state.device = device
+    app.state.pipeline = Trellis2ImageTo3DPipeline.from_pretrained(
+        os.environ.get("TRELLIS_MODEL", "microsoft/TRELLIS.2-4B")
+    )
+    app.state.pipeline.to(device)
+    app.state.generation_lock = asyncio.Lock()
+    app.state.max_upload_bytes = int(os.environ.get("TRELLIS_MAX_UPLOAD_MB", "20")) * 1024 * 1024
+    default_output_dir = Path(__file__).resolve().parent / "generated_glbs"
+    app.state.output_dir = Path(
+        os.environ.get("TRELLIS_API_OUTPUT_DIR", default_output_dir)
+    ).expanduser().resolve()
+    app.state.output_dir.mkdir(parents=True, exist_ok=True)
+    yield
+
+
+app = FastAPI(title="TRELLIS.2 Image to 3D", lifespan=lifespan)
+
+
+@app.get("/health")
+async def health(request: Request):
+    pipeline = getattr(request.app.state, "pipeline", None)
+    device = getattr(request.app.state, "device", None)
+    return {
+        "status": "ready" if pipeline is not None else "starting",
+        "device": str(device) if device is not None else None,
+    }
+
+
+@app.post(
+    "/generate",
+    response_class=FileResponse,
+    responses={
+        200: {
+            "description": "Generated GLB model.",
+            "content": {
+                "model/gltf-binary": {
+                    "schema": {"type": "string", "format": "binary"}
+                }
+            },
+        }
+    },
+)
+async def generate(
+    request: Request,
+    image_file: UploadFile = File(..., alias="image"),
+    pipeline_type: Literal["512", "1024", "1024_cascade", "1536_cascade"] = Query(
+        "512"
+    ),
+):
+    image_bytes = await image_file.read(request.app.state.max_upload_bytes + 1)
+    if len(image_bytes) > request.app.state.max_upload_bytes:
+        await image_file.close()
+        raise HTTPException(status_code=413, detail="Image exceeds the upload size limit.")
+
+    try:
+        with Image.open(BytesIO(image_bytes)) as decoded:
+            decoded.load()
+            image = decoded.copy()
+    except (UnidentifiedImageError, OSError, ValueError) as error:
+        raise HTTPException(status_code=400, detail="Upload must be a supported image.") from error
+    finally:
+        await image_file.close()
+
+    output_path = request.app.state.output_dir / (
+        f"trellis2-{datetime.now():%Y%m%d-%H%M%S}-{uuid4().hex[:8]}.glb"
+    )
+    try:
+        async with request.app.state.generation_lock:
+            await run_in_threadpool(
+                _generate_glb,
+                request.app.state.pipeline,
+                image,
+                pipeline_type,
+                output_path,
+            )
+    except Exception:
+        output_path.unlink(missing_ok=True)
+        output_path.with_suffix(".source.glb").unlink(missing_ok=True)
+        raise
+
+    print(f"Saved generated GLB to {output_path}")
+    return FileResponse(
+        output_path,
+        media_type="model/gltf-binary",
+        filename="trellis2.glb",
+    )
+
+
+def _generate_glb(pipeline, image: Image.Image, pipeline_type: str, output_path: Path):
+    import torch
+
+    from trellis2.utils.glb_utils import export_mesh_with_voxel_to_glb
+
+    with torch.inference_mode():
+        mesh = pipeline.run(image, pipeline_type=pipeline_type)[0]
+        export_mesh_with_voxel_to_glb(
+            mesh,
+            output_path.with_suffix(".source.glb"),
+            simulation_output_path=output_path,
+        )
+
+
+def main():
+    import uvicorn
+
+    uvicorn.run(
+        "trellis2_api:app",
+        host=os.environ.get("TRELLIS_API_HOST", "127.0.0.1"),
+        port=int(os.environ.get("TRELLIS_API_PORT", "8000")),
+    )
