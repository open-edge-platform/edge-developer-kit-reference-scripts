{
    "name": "edge-ai-demo-studio",
    "version": "1.0.0",
    "main": "main.js",
    "author": "Intel CASE CAT CENTRAL",
    "scripts": {
        "start": "electron .",
        "build": "electron-builder",
        "build:dir": "electron-builder --dir",
        "build:linux": "electron-builder --linux",
        "build:win": "electron-builder --win"
    },
    "license": "ISC",
    "description": "Edge AI Demo Studio - Electron Builder Version",
    "devDependencies": {
        "electron": ">=39.8.5",
        "electron-builder": "^26.2.0",
        "@electron/fuses": "^2.0.0"
    },
    "dependencies": {
        "electron-squirrel-startup": "^1.0.1"
    },
    "build": {
        "appId": "com.intel.edge-ai-demo-studio",
        "productName": "EdgeAIStudio",
        "asar": true,
        "directories": {
            "output": "../out",
            "buildResources": "."
        },
        "extraResources": [
            {
                "from": "../build/",
                "to": "./"
            }
        ],
        "afterPack": "./electron-fuses.js",
        "linux": {
            "target": [
                {
                    "target": "zip",
                    "arch": [
                        "x64"
                    ]
                },
                {
                    "target": "deb",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "category": "Development",
            "executableName": "edge-ai-demo-studio"
        },
        "win": {
            "target": [
                {
                    "target": "squirrel",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        },
        "files": [
            "**/*",
            "!**/node_modules/**/*",
            "node_modules/**/*"
        ]
    },
    "overrides": {
        "glob": ">=11.0.3"
    }
}